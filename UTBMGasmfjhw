local GRID = 6

-- ─── Defender Habit Model ────────────────────────────────────────────────────
-- Tracks per-opponent behaviour to bias aim away from their strong coverage zones.
-- Keyed by opponent UserId (or "unknown" for bots). Data persists for the session.
local defender = {
	players   = {},   -- [userId] = model (see defenderNew)
	shotCount = 0,    -- total opponent shots observed this session
}
hub.defender = defender

local function defenderNew()
	-- Return grid: for each 6×6 cell the opponent was in when hitting,
	-- record where their returns landed (which cell on our side).
	-- returnGrid[fromCell][toCell] = count
	local grid = {}
	for i = 1, GRID * GRID do
		grid[i] = {}
		for j = 1, GRID * GRID do grid[i][j] = 0 end
	end
	return {
		returnGrid  = grid,       -- shot origin → return destination counts
		shotCount   = 0,          -- total shots from this opponent
		weakSide    = 0,          -- +1 = right side weak, -1 = left side weak, 0 = unknown
		weakSamples = { L = 0, R = 0, Lspeed = 0, Rspeed = 0 },
		netAggress  = 0,          -- 0–1: how often they come to net
		netSamples  = 0,
		recoveryX   = nil,        -- average X they recover to after hitting
		recoveryZ   = nil,        -- average Z they recover to
		recoverySamples = 0,
		reachTime   = { drop = {}, clear = {}, smash = {} }, -- response times by shot type
		lastHitPos  = nil,        -- where opponent was when they last hit
		lastHitTime = nil,
		ralliesWon  = 0,          -- rallies we won after using learned aim
		ralliesLost = 0,
	}
end

local function defenderGet(c)
	if not c or #c.opps == 0 then return nil end
	-- Use first (or only) opponent. For doubles, combine into shared model.
	local key = "unknown"
	for _, o in ipairs(c.opps) do
		local p = o.char and Players:GetPlayerFromCharacter(o.char)
		if p then key = tostring(p.UserId); break end
	end
	if not defender.players[key] then
		defender.players[key] = defenderNew()
		defender.players[key].key = key
	end
	return defender.players[key]
end

-- Called every step when we see an opponent flight that just launched.
-- Records: where they were standing, shot speed, net aggression snapshot.
local function defenderObserveShot(c, flight)
	if not cfg.learnDefender then return end
	if not flight or flight.team == c.team then return end
	local dm = defenderGet(c)
	if not dm then return end

	-- Find which opponent actually hit (the one on the far side)
	local oppPos
	for _, o in ipairs(c.opps) do
		if o.pos.Z * c.dirZ > 0 then oppPos = o.pos; break end
	end
	if not oppPos then return end

	dm.shotCount = dm.shotCount + 1
	defender.shotCount = defender.shotCount + 1
	dm.lastHitPos  = oppPos
	dm.lastHitTime = c.now

	-- Net aggression: were they close to net when hitting?
	local netDist = abs(oppPos.Z)
	dm.netSamples = dm.netSamples + 1
	local atNet = netDist < 14 and 1 or 0
	dm.netAggress = dm.netAggress + (atNet - dm.netAggress) / dm.netSamples

	-- Weak side: which relative side they were on when they hit
	-- relative to their own court centre. Left of centre = negative.
	local relX = (oppPos.X - c.cx) * (-c.dirZ)  -- flip so "left" is consistent
	local side = relX >= 0 and "R" or "L"
	local spd  = flight.kmh or 0
	dm.weakSamples[side]            = dm.weakSamples[side] + 1
	dm.weakSamples[side .. "speed"] = dm.weakSamples[side .. "speed"] + spd
	-- Weaker side = lower average speed; re-compute after 4+ samples each
	if dm.weakSamples.L >= 4 and dm.weakSamples.R >= 4 then
		local avgL = dm.weakSamples.Lspeed / dm.weakSamples.L
		local avgR = dm.weakSamples.Rspeed / dm.weakSamples.R
		if avgL < avgR - 8 then dm.weakSide = -1   -- left side weaker
		elseif avgR < avgL - 8 then dm.weakSide = 1 -- right side weaker
		else dm.weakSide = 0 end
	end

	-- Record from-cell for this shot (we'll fill to-cell in onRallyEnd or when
	-- the resulting flight lands on our side, tracked via recordFlight).
	local hw = c.halfW
	local ix = clamp(floor((oppPos.X - c.cx + hw) / (2 * hw) * GRID) + 1, 1, GRID)
	local iz = clamp(floor(abs(oppPos.Z) / G.halfL * GRID) + 1, 1, GRID)
	dm._pendingFromCell = (iz - 1) * GRID + ix
end

-- Called when an opponent flight lands on our side: record the from→to cell pair.
local function defenderRecordReturn(c, flight, dm)
	if not dm or not dm._pendingFromCell then return end
	local lp = flight.landPos
	local hw = c.halfW
	local ix = clamp(floor((lp.X - c.cx + hw) / (2 * hw) * GRID) + 1, 1, GRID)
	local iz = clamp(floor(abs(lp.Z) / G.halfL * GRID) + 1, 1, GRID)
	local toCell = (iz - 1) * GRID + ix
	local fromCell = dm._pendingFromCell
	dm.returnGrid[fromCell][toCell] = dm.returnGrid[fromCell][toCell] + 1
	dm._pendingFromCell = nil
end

-- Called after each of our shots lands: record where opponent recovers to ~0.8s later.
local function defenderTrackRecovery(c, dm)
	if not dm or not cfg.learnDefender then return end
	task.delay(0.85, function()
		if not hub.alive then return end
		local cc = hub.ctx
		if not cc then return end
		for _, o in ipairs(cc.opps) do
			if o.pos then
				local n = dm.recoverySamples + 1
				dm.recoveryX = ((dm.recoveryX or o.pos.X) * (n - 1) + o.pos.X) / n
				dm.recoveryZ = ((dm.recoveryZ or o.pos.Z) * (n - 1) + o.pos.Z) / n
				dm.recoverySamples = n
				break
			end
		end
	end)
end

-- Score bonus for aiming at a cell the opponent doesn't cover well.
-- Returns a value in roughly [-0.3, 0.6] to be blended into searchAim score.
local function defenderBonus(c, dm, landPos)
	if not cfg.learnDefender or not dm or dm.shotCount < 6 then return 0 end
	local bonus = 0
	local hw = c.halfW

	-- 1. Aim away from their return cluster (hit where they don't defend FROM)
	if dm._pendingFromCell then
		local row = dm.returnGrid[dm._pendingFromCell]
		local ix = clamp(floor((landPos.X - c.cx + hw) / (2 * hw) * GRID) + 1, 1, GRID)
		local iz = clamp(floor(abs(landPos.Z) / G.halfL * GRID) + 1, 1, GRID)
		local toCell = (iz - 1) * GRID + ix
		local peak = 0
		for j = 1, GRID * GRID do if row[j] > peak then peak = row[j] end end
		if peak > 0 then
			-- Positive bonus for cells they rarely return FROM, negative for their hot zone
			bonus = bonus - 0.35 * (row[toCell] / peak)
		end
	end

	-- 2. Target their weak side
	if dm.weakSide ~= 0 and dm.weakSamples.L >= 4 and dm.weakSamples.R >= 4 then
		local relX = (landPos.X - c.cx)   -- positive = right side from our view
		-- If opponent's left is weak (weakSide=-1), aim to their left = our right (+X when dirZ=1)
		local weakDir = dm.weakSide * c.dirZ
		if relX * weakDir > 0 then bonus = bonus + 0.25 end
	end

	-- 3. Exploit net aggressor with deep shots
	if dm.netAggress > 0.55 and dm.netSamples >= 5 then
		local depth = abs(landPos.Z) / G.halfL
		bonus = bonus + depth * 0.2   -- deeper = better vs net rusher
	end

	-- 4. Aim away from their recovery spot
	if dm.recoveryX and dm.recoverySamples >= 4 then
		local distFromRecovery = abs(landPos.X - dm.recoveryX)
		bonus = bonus + clamp(distFromRecovery / hw, 0, 1) * 0.15
	end

	return bonus * cfg.defenderWeight
end

local function defenderSummary(dm)
	if not dm then return "no data" end
	local ws = dm.weakSide == 1 and "R weak" or dm.weakSide == -1 and "L weak" or "even"
	local net = string.format("net %.0f%%", dm.netAggress * 100)
	return string.format("%d shots | %s | %s", dm.shotCount, ws, net)
end
