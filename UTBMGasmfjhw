	OH = { -25, -16, -9, -3, 3, 9, 16, 26, 38 },
	SIDE = { -18, -10, -4, 2, 8, 14, 22, 32, 42 },
}
local yawSet = { -40, -30, -20, -10, 0, 10, 20, 30, 40 }

local function evalShot(c, kind, contact, t, charge, yaw, pitch, q, errv)
	charge = clamp(charge, 0, 1)
	local hold = charge * chargeTime(kind, kind == "JOH")
	local ok, res = pcall(G.resolver.resolve, {
		pos = contact,
		cx = c.cx,
		dirZ = c.dirZ,
		q = q,
		err = errv,
		aimPitch = pitch,
		aimYaw = yaw,
		charge = charge,
		swingTime = hold + sweetFor(kind, charge),
		kind = kind == "JOH" and "OH" or kind,
		hand = c.hand,
		jump = kind == "JOH" and 0.95 or nil,
		jumpMax = kind == "JOH",
		doubles = c.doubles,
	})
	if not ok or not res or not res.vel then return nil end
	local okSim, sim = pcall(G.physics.simulate, contact, res.vel, t, c.cx)
	if not okSim or not sim then return nil end
	return sim, res
end

local function netClearance(sim)
	local pts = sim.pts
	for i = 2, #pts do
		local a, b = pts[i - 1], pts[i]
		if (a.Z < 0) ~= (b.Z < 0) then
			local f = a.Z / (a.Z - b.Z)
			local y = a.Y + (b.Y - a.Y) * f
			return y - (G.config.NET_H_POST + G.floorY)
		end
	end
	return -huge
end

local function shotIn(c, sim, margin)
	if sim == nil or sim.netHit then return false end
	-- A cord shot (clips the top of the net and dribbles over) is accepted only when:
	--   1. cordTry was rolled true for this shot (context-aware: net taps only, see searchAim caller)
	--   2. The cord lands IN bounds — we don't want cords that land out
	if sim.netKind ~= nil then
		if not S.cordTry then return false end
		-- For cord shots, still require the ball lands on the correct side and in court
		if sim.landPos.Z * c.dirZ <= 0 or not landsIn(c, sim.landPos, margin) then return false end
		return true  -- cord that lands in = accept
	end
	if sim.landPos.Z * c.dirZ <= 0 or not landsIn(c, sim.landPos, margin) then return false end
	return netClearance(sim) >= cfg.netClear * 4.5
end

local function robustShot(c, kind, contact, t, cand, margin)
	local noise = cfg.aimNoise + 1.5
	local qLow = select(1, G.resolver.gradeTiming(max(cfg.timingSpread / 1000, 0.03))) or 0.6
	local variants = {
		{ cand.charge + ((kind == "FH" or kind == "BH") and 0.25 or 0.12), cand.yaw, cand.pitch, 1, 0 },
		{ cand.charge - 0.1, cand.yaw, cand.pitch, 1, 0 },
		{ cand.charge, cand.yaw + noise, cand.pitch + noise * 0.6, 1, 0 },
		{ cand.charge, cand.yaw - noise, cand.pitch - noise * 0.6, 1, 0 },
		{ cand.charge, cand.yaw, cand.pitch, qLow, 0.05 },
		{ cand.charge, cand.yaw, cand.pitch, qLow, -0.05 },
		{ cand.charge + 0.06, cand.yaw + 6, cand.pitch, 1, 0 },
		{ cand.charge + 0.06, cand.yaw - 6, cand.pitch, 1, 0 },
	}
	for _, v in ipairs(variants) do
		local sim = evalShot(c, kind, contact, t, v[1], v[2], v[3], v[4], v[5])
		if not shotIn(c, sim, margin * 0.4) then return false end
	end
	for _, offset in ipairs({ v3(0, -1.2, 0), v3(0, 0, 1.5), v3(0, 0, -1.5), v3(1.2, 0, 0), v3(-1.2, 0, 0) }) do
		local sim = evalShot(c, kind, contact + offset, t, cand.charge, cand.yaw, cand.pitch, 1, 0)
		if not shotIn(c, sim, margin * 0.4) then return false end
	end
	return true
end

local function searchAim(c, opts)
	S.searchToken = S.searchToken + 1
	local token = S.searchToken
	local margin = cfg.lineMargin * 4.5
	task.spawn(function()
		local list = {}
		local count = 0
		local kind = opts.kind
		local overhead = kind == "OH" or kind == "JOH"
		local tap = isNetTap(opts.contact)
		local yaws, pitches
		if tap and not opts.center then
			-- Raised pitch floor from 4 → 10 so the resolver opens with upward arcs near the net.
			-- Low starting pitch (4°) with any undershoot in charge lands in the net.
			yaws, pitches = yawSet, { 10, 16, 22, 28, 35, 42, 50 }
		elseif opts.center then
			yaws, pitches = {}, {}
			for i = -4, 4 do yaws[#yaws + 1] = clamp(opts.center.yaw + i * 2.5, -50, 50) end
			for i = -4, 4 do pitches[#pitches + 1] = clamp(opts.center.pitch + i * 2, -30, 45) end
		else
			yaws, pitches = yawSet, overhead and pitchSets.OH or pitchSets.SIDE
		end
		if not opts.center and abs(opts.contact.Z) < 16 then
			local narrow = {}
			for i, y in ipairs(yaws) do narrow[i] = y * 0.5 end
			yaws = narrow
		end
		local function yieldCheck()
			count = count + 1
			if count % 40 == 0 then
				RunService.Heartbeat:Wait()
				if token ~= S.searchToken or not hub.alive then return false end
			end
			return true
		end
		-- FIX: net shot pitch floor — when contact is close to and below the net
		-- (drop shots, tight net returns), flat pitches clip the net. Compute a
		-- minimum pitch bias proportional to how much the ball needs to lift.
		local netBoostPitch = 0
		if opts.contact then
			local contactZ  = abs(opts.contact.Z)
			local contactH  = opts.contact.Y - G.floorY
			local netPostH  = G.config.NET_H_POST or 5.0
			-- Floor-level contacts (post-dive at the baseline) need pitch boost across the
			-- whole court — the old 30-stud zone left baseline dives completely unboosted.
			local atFloor   = contactH < 2.0
			local zoneDist  = atFloor and (G.halfL + 5) or 30
			if contactZ < zoneDist and contactH < netPostH + 1.5 then
				local hDeficit   = max(netPostH - contactH + 0.6, 0)
				local baseMult   = atFloor and 10.0 or 7.0
				local distFactor = clamp((zoneDist - contactZ) / zoneDist, 0, 1)
				netBoostPitch = hDeficit * distFactor * baseMult
			end
		end

		for _, charge in ipairs(opts.charges) do
			for _, pitch in ipairs(pitches) do
				-- Apply net clearance pitch floor: skip pitches that are too flat
				-- when contact is close to/below the net.
				local effectivePitch = pitch + netBoostPitch
				local allowed = tap or opts.center ~= nil or styleAllows(opts.style, kind, effectivePitch)
				if netBoostPitch > 0 and pitch < -netBoostPitch then allowed = false end
				if allowed then
					for _, yaw in ipairs(yaws) do
						local sim, res = evalShot(c, kind, opts.contact, opts.t, charge, yaw, effectivePitch, 1, 0)
						if shotIn(c, sim, margin) then
							local side = abs(sim.landPos.X - c.cx) / c.halfW
							local score = -oppSlack(c, sim) + trackerBonus(c, sim.landPos) - (sim.landTime - opts.t) * 0.05 - max(side - 0.55, 0) * 2 - abs(yaw) / 120
							-- Tap depth penalty cut from 0.4 → 0.08: the old value heavily biased the
							-- resolver toward the shallowest landing, causing near-net shots to consistently
							-- undershoot. A tiny penalty still mildly prefers net drops but won't override
							-- charge/pitch combos that actually clear to mid-court.
							if tap then score = score - abs(sim.landPos.Z) / G.halfL * 0.08 else score = score + styleBonus(opts.style, sim, res) end
							-- Defender habit bonus: bias away from their coverage zones
							score = score + defenderBonus(c, opts.defModel, sim.landPos)
							-- Smash bias: reward steep downward overhead shots with high speed.
							-- effectivePitch < 0 = angled down (smash direction); high kmh = power.
							-- smashBias=0 has no effect; smashBias=1 strongly favors smashes over drops/clears.
							-- Smash bias: only apply when overhead AND not a net tap AND contact is far from net.
							-- Near-net overhead shots (contact Z < 13) must NOT smash — they go out of bounds.
							local farFromNet = abs(opts.contact.Z) >= 13
							if overhead and cfg.smashBias > 0 and not tap and farFromNet then
								local steepness = clamp(-effectivePitch / 20, 0, 1)  -- 0=flat, 1=very steep (tighter window = rewards steeper smashes more)
								local speed = clamp((res.speedKmh or 0) / 280, 0, 1)
								-- Raised multiplier (was 0.8) so smash bias clearly beats drop/clear at high settings
								score = score + cfg.smashBias * steepness * speed * 1.6
							end
							-- Serve receive bias: prefer a soft, short return (net drop / tight backhand).
							-- Reward shots that land close to the net on opponent's side (low abs Z)
							-- and are on the BH side of the opponent's court (negative X relative to cx).
							if opts.serveReceive then
								local oppLandZ = sim.landPos.Z * c.dirZ  -- positive = opponent's depth
								local shortness = clamp(1 - oppLandZ / G.halfL, 0, 1)  -- 1=very short, 0=deep
								score = score + shortness * 1.2  -- strongly prefer short returns
								local bhSide = (sim.landPos.X - c.cx) * c.dirZ  -- + = backhand side of opp
								if bhSide > 0 then score = score + 0.4 end  -- small boost to BH placement
							end
							-- Lift-clear bias: opponent is camping near the net smashing everything.
							-- Push back with a deep, high-arcing clear — penalise short/net returns and
							-- reward shots landing in the back third of their court at a high angle.
							-- effectivePitch > 0 = upward arc (lift/clear); land far from net = deep.
							if opts.liftClear and not tap then
								local oppLandZ = sim.landPos.Z * c.dirZ  -- + = their depth
								local depth = clamp(oppLandZ / G.halfL, 0, 1)  -- 0=net, 1=baseline
								local height = clamp(effectivePitch / 20, 0, 1)  -- 0=flat, 1=steep lift
								score = score + (depth * 0.9 + height * 0.6)  -- reward deep+high
								if depth < 0.4 then score = score - 1.5 end  -- strongly penalise short returns when lifting
							end
							-- Store effectivePitch so aim/release use the net-boosted angle
							list[#list + 1] = { score = score, yaw = yaw, pitch = effectivePitch, charge = charge, land = sim.landPos, landTime = sim.landTime, shot = res.shot, kmh = res.speedKmh, id = opts.id, kind = kind }
						end
						if not yieldCheck() then return end
					end
				end
			end
		end
		if #list == 0 and not opts.retry then
			opts.retry = true
			opts.charges = { 0.1, 0.25, 0.4, 0.55, 0.7, 0.85, 1 }
			opts.center = nil
			opts.style = nil
			S.searchToken = S.searchToken - 1
			return searchAim(c, opts)
		end
		table.sort(list, function(a, b) return a.score > b.score end)
		local best
		for i = 1, min(#list, 12) do
			if robustShot(c, kind, opts.contact, opts.t, list[i], margin) then
				best = list[i]
				best.safe = true
				break
			end
			for _ = 1, 6 do if not yieldCheck() then return end end
		end
		best = best or list[1]
		if token == S.searchToken then S.searchDone = token end
		if token == S.searchToken and best then
			best.refined = opts.center ~= nil
			S.aim = best
		end
	end)
end

local function cameraAim(c)
	local look = camera.CFrame.LookVector
	local u = flat(look)
	if u.Magnitude < 1e-3 then return nil end
	u = u.Unit
	local cf = G.config
	local yaw = math.deg(math.atan2(u:Dot(v3(-c.dirZ, 0, 0)), u:Dot(v3(0, 0, c.dirZ)))) * cf.AIM_YAW_SCALE
	local pitch = clamp(math.deg(math.asin(clamp(look.Y, -1, 1))) + (S.aimOffset or 0), cf.AIM_PITCH_MIN, cf.AIM_PITCH_MAX)
	return clamp(yaw, -cf.AIM_YAW_MAX, cf.AIM_YAW_MAX), pitch
end

local function actualShotOk(c, sw, hit, chargeAt)
	if not hit or not hit.contact then return true end
	local okAim, yaw, pitch = pcall(G.fn.aimAngles)
	if not okAim then yaw, pitch = cameraAim(c) end
	if not yaw then return true end
	local charge = chargeAt or clamp((c.now - sw.pressedAt) / chargeTime(sw.kind, sw.kind == "JOH"), 0, 1)
	local q = G.resolver.gradeTiming(abs(hit.err)) or 0.3
	local sim = evalShot(c, sw.kind, hit.contact, hit.tc, charge, yaw, pitch, q, hit.err)
	return shotIn(c, sim, 1.1), sim
end

local function rescueAim(c, sw, hit)
	local yaw, pitch = cameraAim(c)
	if not yaw or not hit or not hit.contact then return nil end
	local charge = clamp((c.now - sw.pressedAt) / chargeTime(sw.kind, sw.kind == "JOH"), 0, 1)
	local cf = G.config
	local okAim, gameYaw = pcall(G.fn.aimAngles)
	if okAim and gameYaw then yaw = gameYaw end
	local best, bestScore
	local tol = cf.AIM_BODY_TOLERANCE or 5
	for p = cf.AIM_PITCH_MIN, cf.AIM_PITCH_MAX, 2.5 do
		for y = yaw - tol, yaw + tol, tol do
			local sim, res = evalShot(c, sw.kind, hit.contact, hit.tc, charge, y, p, 1, 0)
			if shotIn(c, sim, cfg.lineMargin * 2) then
				local score = -oppSlack(c, sim) - (abs(y - yaw) + abs(p - pitch)) * 0.01
				if not bestScore or score > bestScore then
					bestScore = score
					best = { yaw = y, pitch = p, charge = charge, land = sim.landPos, landTime = sim.landTime, shot = res.shot, kmh = res.speedKmh, id = sw.id, kind = sw.kind, noiseYaw = 0, noisePitch = 0, rescue = true }
				end
			end
		end
	end
	return best
end

local function refineAim(c, flight, sw)
	if not S.aim or S.aim.id ~= sw.id then return end
	local plan = S.plan
	if not plan then return end
	local kind = sw.kind
	local ct = chargeTime(kind, kind == "JOH")
	local late = S.lateBy and S.lateBy[kind] or 0
	local charge = clamp((plan.t - sweetFor(kind, S.aim.charge) + late - sw.pressedAt) / ct, 0, 1)
	charge = clamp((plan.t - sweetFor(kind, charge) + late - sw.pressedAt) / ct, 0, 1)
	local live = sw.lastHit
	if live and live.err and kind ~= "JOH" then
		local releaseAt = c.now + max(-live.err + (sw.target or 0), 0)
		charge = clamp((releaseAt - sw.pressedAt) / ct, 0, 1)
	end
	local contact = plan.contact
	local hit = detectAt(c, flight, kind == "JOH" and "OH" or kind, plan.t - sweetFor(kind, charge), sweetFor(kind, charge))
	if hit and hit.contact then contact = hit.contact end
	sw.predCharge = charge
	searchAim(c, { id = sw.id, kind = kind, contact = contact, t = hit and hit.tc or plan.t, charges = { charge }, center = { yaw = S.aim.yaw, pitch = S.aim.pitch }, defModel = defenderGet(c) })
end

local function withAim(_, fn, ...)
	local ok, err = pcall(fn, ...)
	if not ok then hub.errors.swing = err end
end

local function aimTarget(aim, dirZ)
	if not aim then return nil end
	if not aim.noiseYaw then
		aim.noiseYaw = randRange(-cfg.aimNoise, cfg.aimNoise)
		aim.noisePitch = randRange(-cfg.aimNoise, cfg.aimNoise) * 0.6
	end
	return { yaw = aim.yaw + aim.noiseYaw, pitch = aim.pitch + aim.noisePitch, dirZ = dirZ }
end

local function stopMoving(c)
	if S.moving and c then c.hum:MoveTo(c.hrp.Position) end
	S.moving = false
	holdKey(Enum.KeyCode.LeftShift, false)
end

local function moveTo(c, target, sprint)
	local pos = c.hrp.Position
	local d = flatDist(target, pos)
	if d > 0.4 then
		local goal = v3(target.X, pos.Y, target.Z)
		if c.mate then
			local seg = flat(goal - pos)
			local rel = flat(c.mate - pos)
			local along = clamp(rel:Dot(seg.Unit), 0, seg.Magnitude)
			local closest = pos + seg.Unit * along
			local off = flat(closest - c.mate)
			if along > 0.5 and off.Magnitude < 3.2 and flatDist(goal, c.mate) > 2 then
				local perp = off.Magnitude > 0.1 and off.Unit or v3(-seg.Unit.Z, 0, seg.Unit.X)
				goal = v3(c.mate.X, pos.Y, c.mate.Z) + perp * 3.6
			end
		end
		c.hum:MoveTo(goal)
		S.moving = true
		-- With infinite stamina the game's stamina value may still read low (DIVE_COST is 0
		-- but the regen hasn't caught up). Treat it as 100 so sprint checks always pass.
		local effectiveStamina = cfg.infiniteStamina and 100 or c.stamina
		-- Post-dive: also lower the threshold so we sprint even when drained
		local postDiveSprint = S.divedAt and (c.now - S.divedAt) < 2.5
		local sprintThresh = postDiveSprint and 3 or cfg.staminaReserve
		holdKey(Enum.KeyCode.LeftShift, sprint == "force" and effectiveStamina > 3 or (sprint and effectiveStamina > sprintThresh))
	else
		stopMoving(c)
	end
	return d
end

local function faceNet(c, dt)
	local look = flat(c.hrp.CFrame.LookVector)
	if look.Magnitude < 1e-3 then return end
	local current = math.atan2(-look.X, -look.Z)
	local target = math.atan2(0, -c.dirZ)
	local diff = (target - current + math.pi) % (2 * math.pi) - math.pi
	if abs(diff) < rad(4) then return end
	local step = clamp(diff, -rad(540) * dt, rad(540) * dt)
	c.hrp.CFrame = CFrame.new(c.hrp.Position) * CFrame.Angles(0, current + step, 0)
end

local function basePosition(c)
	local smashing = c.oppJump or (S.oppJumpAt and c.now - S.oppJumpAt < 0.8)
	-- Smash defense: step deeper (0.55 of half-court) and lock to court center X
	-- so the bot is pre-positioned to cover cross-court and straight smashes equally.
	-- If opponent is near the net when jumping (net kill), step shallower (0.3).
	local depth = G.halfL * (smashing and (S.oppNearNet and 0.3 or 0.55) or 0.37)
	local x = c.cx
	-- Tighter drift: ±0.6 studs X, ±0.5 studs Z so bot stays centered and
	-- can reach any corner quickly. Refreshes every 1.5–2.5s.
	if not S.driftAt or c.now > S.driftAt then
		S.driftAt = c.now + randRange(1500, 2500) / 1000
		S.drift = v3(randRange(-60, 60) / 100, 0, randRange(-50, 50) / 100)
	end
	local drift = smashing and v3() or S.drift
	if c.mate then
		local side = c.mate.X >= c.cx and -1 or 1
		if abs(c.mate.X - c.cx) < 1.5 then side = c.hrp.Position.X >= c.cx and 1 or -1 end
		return v3(c.cx + side * c.halfW * 0.45, 0, -c.dirZ * depth) + drift
	end
	-- Bias X slightly toward where our last shot landed (opponent will likely return cross)
	-- but keep it mild (0.2 weight) so the bot doesn't over-commit to one side.
	if smashing then
		x = c.cx  -- dead center for smash defense
	elseif S.aim and S.aim.land then
		x = c.cx + (S.aim.land.X - c.cx) * 0.2
	end
	return v3(x, 0, -c.dirZ * depth) + drift
end

local function doRelease(c, kind)
	local aim = (cfg.autoAim and S.aim and S.aim.id == (S.swing and S.swing.id)) and S.aim or nil
	if (kind == "FH" or kind == "BH") and c.flight then
		local other = kind == "FH" and "BH" or "FH"
		local ok1, mine = pcall(detectAt, c, c.flight, kind, c.now, sweetFor(kind, 0.4))
		local ok2, theirs = pcall(detectAt, c, c.flight, other, c.now, sweetFor(other, 0.4))
		if ok2 and theirs and (not (ok1 and mine) or abs(theirs.err) + 0.03 < abs(mine.err)) then
			pcall(up.set, "press", 7, actionFor(c, other))
			kind = other
			if S.swing then S.swing.kind = other end
		end
	end
	withAim(aim, G.fn.release, actionFor(c, kind == "JOH" and "OH" or kind))
end

local function predictRelease(c, flight, kind, charge, untilT)
	local strokeKind = kind == "JOH" and "OH" or kind
	local sweet = sweetFor(kind, charge)
	local tp = max(c.now, untilT - 0.9)
	untilT = min(untilT, c.now + 1.5)
	while tp <= untilT do
		local r = detectAt(c, flight, strokeKind, tp, sweet)
		if r and r.err >= 0 then return tp end
		tp = tp + 0.017
	end
	return nil
end

local function tryRelease(c, flight, kind, pressedAt, target)
	local ct = chargeTime(kind, c.airborne)
	local charge = clamp((c.now - pressedAt) / ct, 0, 1)
	local sweet = sweetFor(kind, charge)
	local strokeKind = kind == "JOH" and "OH" or kind
	local a = detectAt(c, flight, strokeKind, c.now, sweet)
	local b = detectAt(c, flight, strokeKind, c.now + S.lastDt, sweet)
	S.lastDetect = { a = a and a.err, b = b and b.err, kind = kind, charge = charge, t = c.now }
	if a then
		if a.err >= target - S.lastDt * 0.5 then return true, a end
	end
	return false, a
end

local function runServe(c)
	if S.serving then return end
	S.serving = true
	local matchState = c.model:GetAttribute("MatchId")
	task.spawn(function()
		local okRun, errRun = pcall(function()
			task.wait(randRange(0.7, 1.6))
			local cc = context()
			if not cc or cc.state ~= "ServeReady" or cc.model:GetAttribute("ServerId") ~= localPlayer.UserId then return end
			local contact = G.fn.serveContact(cc.hum, cc.hrp)
			local sign = cc.model:GetAttribute("ServeSign") or 1
			local receiverRef = cc.model:FindFirstChild("ReceiverChar")
			local receiver = receiverRef and receiverRef.Value
			local receiverRoot = receiver and receiver:FindFirstChild("HumanoidRootPart")
			if receiverRoot then cc.opps = { { pos = receiverRoot.Position } } end
			local best
			local count = 0
			local cf = G.config
			for pitch = -12, 44, 4 do
				local kind = G.resolver.serveType(pitch)
				local allowed = cfg.serveStyle == "Auto" or (cfg.serveStyle == "Short" and kind == "SHORT") or (cfg.serveStyle == "Flick" and kind == "FLICK") or (cfg.serveStyle == "High" and kind == "HIGH")
				if allowed then
					for yaw = -24, 24, 6 do
						local ok, res = pcall(G.resolver.resolve, { kind = "SERVE", pos = contact, cx = cc.cx, dirZ = cc.dirZ, aimYaw = yaw, aimPitch = pitch, doubles = cc.doubles, q = 1, err = 0 })
						if ok and res then
							local okSim, sim = pcall(G.physics.simulate, contact, res.vel, cc.now, cc.cx)
							if okSim and sim and not sim.netHit and G.physics.inServiceCourt(sim.landPos, sign, cc.cx, cc.doubles) then
								local inner = landsIn(cc, sim.landPos, cfg.lineMargin * 4.5)
								if inner then
									local score = -oppSlack(cc, sim)
									if kind == "SHORT" then score = score + 0.05 end
									if not best or score > best.score then best = { score = score, yaw = yaw, pitch = pitch, land = sim.landPos, shot = res.shot } end
								end
							end
						end
						count = count + 1
						if count % 10 == 0 then RunService.Heartbeat:Wait() end
					end
				end
			end
			cc = context()
			if not cc or cc.state ~= "ServeReady" or cc.model:GetAttribute("ServerId") ~= localPlayer.UserId then return end
			S.serveAim = best
			if best and cfg.autoAim then
				S.serveTarget = aimTarget(best, cc.dirZ)
				local waitUntil = os.clock() + 3
				while os.clock() < waitUntil do
					local okA, yaw, pitch = pcall(G.fn.aimAngles)
					if okA and yaw then
						local okR, res = pcall(G.resolver.resolve, { kind = "SERVE", pos = contact, cx = cc.cx, dirZ = cc.dirZ, aimYaw = yaw, aimPitch = pitch, doubles = cc.doubles, q = 1, err = 0 })
						local okS, sim = okR and res and pcall(G.physics.simulate, contact, res.vel, workspace:GetServerTimeNow(), cc.cx)
						if okS and sim and not sim.netHit and G.physics.inServiceCourt(sim.landPos, sign, cc.cx, cc.doubles) then break end
					end
					task.wait()
				end
			end
			-- Track whether we served short so we can sprint back after the serve
			S.servedShort = best and G.resolver.serveType(best.pitch) == "SHORT"
			G.fn.press("SERVE")
			local spread = min(cfg.timingSpread / 1000, cf.SERVE_T_PERFECT * 0.8)
			task.wait(cf.SERVE_METER_TIME * cf.SERVE_METER_SWEET + randRange(-spread, spread))
			G.fn.release("SERVE")
			task.wait(0.2)
			S.serveTarget = nil
		end)
		if not okRun then hub.errors.serve = errRun end
		S.serveTarget = nil
		task.wait(1)
		local cc = context()
		while hub.alive and cc and cc.state == "ServeReady" and cc.model:GetAttribute("MatchId") == matchState and cc.model:GetAttribute("ServerId") == localPlayer.UserId do
			task.wait(0.25)
			cc = context()
		end
		S.serving = false
	end)
end

local function recordFlight(c, flight)
	if S.lastFlight == flight.id then return end
	S.lastFlight = flight.id
	if flight.team ~= c.team and not flight.isServe and flight.landPos then
		local ix, iz = cellOf(flight.landPos.X, flight.landPos.Z, c.cx, c.halfW)
		tracker.mine[ix][iz] = tracker.mine[ix][iz] + 1
		tracker.mineTotal = tracker.mineTotal + 1
		-- Defender model: record that this opponent shot will land in a specific cell
		local dm = defenderGet(c)
		defenderRecordReturn(c, flight, dm)
	end
	-- Observe a new opponent shot launching: snapshot their position + attributes
	if flight.team ~= c.team and not flight.isServe then
		defenderObserveShot(c, flight)
	end
end

local autoSwing = {}

function autoSwing.jump(c, plan, sw)
	sw.jumped = true
	sw.jumpAt = c.now
	S.lastJumpAt = c.now   -- track jump time so dive is suppressed during landing animation
	hub.logger.add("JUMP", "id", plan.id, "t", plan.t - c.now, "stamina", c.stamina)
	sw.kind = "JOH"
	sw.lockedPlan = plan
	-- Release sprint and stop movement immediately — holding Shift during the jump coil breaks animation.
	holdKey(Enum.KeyCode.LeftShift, false)
	stopMoving(c)
	if G.fn.requestJump and G.fn.__render then
		pcall(G.fn.requestJump)
		pcall(debug.setupvalue, G.fn.__render, 26, true)
		task.delay(G.config.JUMP_CHARGE_TIME + 0.01, function()
			pcall(debug.setupvalue, G.fn.__render, 26, false)
			if G.fn.releaseJump then pcall(G.fn.releaseJump) end
		end)
	else
		holdKey(Enum.KeyCode.Space, true)
		task.delay(G.config.JUMP_CHARGE_TIME, function() holdKey(Enum.KeyCode.Space, false) end)
	end
	G.fn.press("OH")
	sw.pressed, sw.pressedAt = true, c.now
end

function autoSwing.press(c, flight, plan, id, sw)
	local kind = plan.kind
	local aimReady = S.aim and S.aim.id == id
	-- Net tap default raised from 0.15 → 0.40: 0.15 produced near-net whimps that clipped the net
	local charge = (cfg.autoAim and aimReady) and S.aim.charge or (isNetTap(plan.contact) and 0.40 or 0.5)
	local ct = chargeTime(kind, kind == "JOH")
	local sweet = sweetFor(kind, charge)

	-- FIX: pressLeadFactor replaces hardcoded 0.3 overhead early-press offset.
	-- Was causing over-charge on fast smashes. Now tunable.
	local earlyOhBonus = (kind == "OH" and charge >= 0.85) and (cfg.pressLeadFactor * 0.4) or 0
	local pressAt = plan.t - sweet + autoSwing.late(kind) - charge * ct - earlyOhBonus
	sw.plannedCharge = charge
	-- Press trigger radius: must be physically close to stand before pressing.
	-- OH/JOH: 1.4 studs (small contact window). FH/BH: 1.5 studs (was 2.2 — too loose).
	local nearRadius = (kind == "OH" or kind == "JOH") and 1.4 or 1.5
	local near = flatDist(plan.stand, c.hrp.Position) <= nearRadius
	local lastCall = plan.t - sweet - 0.12
	if kind == "FH" or kind == "BH" then
		lastCall = plan.t - sweet - 0.06 - cfg.pressLeadFactor * chargeTime(kind, false)
		pressAt = huge
		if plan.t - c.now < 1.2 then
			local releaseAt = predictRelease(c, flight, kind, charge, plan.t + 0.4)
			local settled = flatDist(plan.stand, c.hrp.Position) <= 1.2
				or (releaseAt and releaseAt - c.now <= 0.16)
			if releaseAt and settled then
				pressAt = max(releaseAt, plan.t - sweet) - charge * ct + autoSwing.late(kind)
				lastCall = pressAt
				sw.expectRelease = releaseAt
				near = true
			elseif releaseAt then
				lastCall = max(lastCall, releaseAt - charge * ct)
			end
		end
	elseif kind == "OH" then
		local releaseAt = plan.t - c.now < 1.5 and predictRelease(c, flight, "OH", charge, plan.t + 0.4)
		if releaseAt then
			pressAt = max(releaseAt, plan.t - sweet) - charge * ct + autoSwing.late(kind) - earlyOhBonus
			lastCall = pressAt
			sw.expectRelease = releaseAt
		else
			-- predictRelease returned nil (net-tight, fast drop, or detection gap).
			-- Fall back to time-based press instead of blocking forever with huge.
			-- Without this the bot walks to the net, has a valid plan, and never swings.
			pressAt = plan.t - sweet - charge * ct + autoSwing.late(kind) - earlyOhBonus
			lastCall = pressAt
		end
	end
	if kind ~= "FH" and kind ~= "BH" then lastCall = max(lastCall, pressAt) end
	-- Block press if still far from the stand position, unless it's truly the last moment.
	-- Tightened from 4.0 to 1.8: firing 4 studs from stand caused whiffs and short shots.
	local veryLate = c.now >= lastCall and flatDist(plan.stand, c.hrp.Position) <= 1.8
	-- If aim search produced no result and we're close to the deadline, stop waiting and swing anyway.
	-- Defender model returning all-negative scores can leave S.aim nil indefinitely.
	local aimTimedOut = not aimReady and c.now >= plan.t - sweet - 0.35
	if cfg.autoAim and not aimReady and not aimTimedOut and kind ~= "JOH" and c.now < plan.t - sweet - 0.3 then
		sw.waitedAim = true
	elseif kind == "JOH" then
		local beginAt = plan.t - G.jumpLead - G.jumpApexT
		if c.now >= beginAt - 0.08 and c.now <= beginAt + 0.1 and flatDist(plan.stand, c.hrp.Position) <= 2.5 then
			autoSwing.jump(c, plan, sw)
		elseif c.now > beginAt + 0.1 then
			S.noJumpFor = id
		end
	elseif (near and c.now >= pressAt) or veryLate or (aimTimedOut and near) then
		if kind == "FH" or kind == "BH" then
			local right = flat(c.hrp.CFrame.RightVector)
			local side = flat(plan.contact - c.hrp.Position):Dot(right) * c.hand
			if abs(side) > 0.6 then kind = side > 0 and "FH" or "BH" end
			kind = autoSwing.pickSide(c, flight, plan, charge) or kind
			plan.kind = kind
		end
		sw.kind = kind
		sw.lockedPlan = plan
		G.fn.press(actionFor(c, kind))
		sw.pressed, sw.pressedAt = true, c.now
	end
end

function autoSwing.pickSide(c, flight, plan, charge)
	local best, bestErr
	for _, kind in ipairs({ "FH", "BH" }) do
		local sweet = sweetFor(kind, charge)
		local tp = max(c.now, plan.t - 0.6)
		while tp <= plan.t + 0.25 do
			local ok, hit = pcall(detectAt, c, flight, kind, tp, sweet)
			if ok and hit and hit.err and (not bestErr or abs(hit.err) < bestErr) then
				best, bestErr = kind, abs(hit.err)
			end
			tp = tp + 0.03
		end
	end
	return best
end

S.lateBy = { OH = 0, JOH = 0, FH = 0, BH = 0 }
function autoSwing.late(kind)
	return clamp(S.lateBy[kind] or 0, 0, 0.08)
end

function autoSwing.learn(c, plan, sw, fire)
	if not fire or not plan or not sw.kind or sw.kind == "JOH" then return end
	local planned = sw.plannedCharge or 0.5
	local expected = sw.expectRelease or plan.t - sweetFor(sw.kind, planned)
	local late = clamp(c.now - expected, -0.2, 0.4)
	S.lateBy[sw.kind] = (S.lateBy[sw.kind] or 0) * 0.7 + late * 0.3
end

function autoSwing.log(c, plan, id, sw, fire, hit, shotOk)
	hub.shotLog = hub.shotLog or {}
	hub.logger.add("SWING", "id", id, sw.kind, "held", c.now - sw.pressedAt, "err", hit and hit.err, "fired", fire, "shotOk", shotOk,
		"charge", (c.now - sw.pressedAt) / chargeTime(sw.kind, sw.kind == "JOH"), "aimCharge", S.aim and S.aim.id == id and S.aim.charge, "aimLand", S.aim and S.aim.id == id and S.aim.land)
	table.insert(hub.shotLog, {
		id = id, kind = sw.kind, held = c.now - sw.pressedAt, err = hit and hit.err, forced = not fire,
		planT = plan and plan.t - c.now, detect = S.lastDetect, shotOk = shotOk, heldFrames = sw.held,
		charge = clamp((c.now - sw.pressedAt) / chargeTime(sw.kind, sw.kind == "JOH"), 0, 1),
		aimCharge = S.aim and S.aim.id == id and S.aim.charge, aimShot = S.aim and S.aim.id == id and S.aim.shot,
		contact = hit and hit.contact or (plan and plan.contact), tap = plan and isNetTap(plan.contact), waited = sw.waitedAim,
	})
	if #hub.shotLog > 30 then table.remove(hub.shotLog, 1) end
end

function autoSwing.release(c, flight, plan, id, sw)
	local fire, hit = tryRelease(c, flight, sw.kind, sw.pressedAt, sw.target)
	local shotOk = true
	if not fire and hit and hit.err and sw.kind ~= "JOH" then
		local planned = sw.plannedCharge or 0.5
		local now = (c.now - sw.pressedAt) / chargeTime(sw.kind, false)
		if now >= planned + 0.06 and hit.err >= -0.04 then fire = true end
	end
	-- FIX: raise the early-swing block threshold slightly; -0.08s was too conservative
	-- and caused whiffs on flat drives arriving fast to the body. -0.06 is safer.
	if fire and hit and hit.err and hit.err < -0.06 and plan and c.now < plan.t + 0.1 then fire = false end
	sw.lastHit = hit
	if fire and cfg.autoAim then
		shotOk = actualShotOk(c, sw, hit)
		if not shotOk then
			if not sw.rescued then
				sw.rescued = true
				S.searchToken = S.searchToken + 1
				local fix = rescueAim(c, sw, hit)
				if fix then
					S.aim = fix
					S.camAligned = false
					sw.rescueFound = true
				end
			end
			local held = sw.held or 0
			if hit.err < G.config.T_GOOD - 0.04 and held < (S.smashFor == sw.id and 2 or 12) and (not S.camAligned or (sw.rescueFound and held < 2) or c.now - sw.pressedAt < 0.1) then
				fire = false
				S.urgentAim = true
				sw.held = held + 1
			end
		end
	end
	local deadline = (plan and plan.t or flight.landTime) + 0.15
	if hit and hit.err and hit.err < 0 then deadline = max(deadline, flight.landTime - 0.05) end
	if not hit then deadline = max(deadline, flight.landTime - 0.05) end

	-- FIX: whiff tracking — if we've force-fired 3+ times on this flight without
	-- a real hit reading, trust the deadline and let it go. Avoids infinite hold loops
	-- when detectAt returns nil on fast body shots.
	local whiffs = S.whiffCount[id] or 0
	if not hit and c.now > deadline - 0.05 then
		whiffs = whiffs + 1
		S.whiffCount[id] = whiffs
	end
	local forceRelease = not hit and whiffs >= 3

	if fire or forceRelease or c.now > deadline then
		S.urgentAim = false
		sw.released, sw.releasedAt = true, c.now
		autoSwing.log(c, plan, id, sw, fire, hit, shotOk)
		autoSwing.learn(c, plan, sw, fire)
		doRelease(c, sw.kind)
		-- Track where opponent recovers to after our shot lands
		defenderTrackRecovery(c, defenderGet(c))
	end
end

function autoSwing.dive(c, flight, id)
	local dir = flat(flight.landPos - c.hrp.Position)
	if dir.Magnitude <= 0.1 then return end
	local okPlan, dplan = pcall(G.fn.planDive, c.hum, c.hrp, dir.Unit)
	if okPlan and type(dplan) == "table" and dplan.flight then
		S.diveFor = id
		S.divedAt = c.now  -- track dive time so post-dive sprint ignores stamina reserve
		stopMoving(c)
		withAim(nil, G.fn.dive, dir.Unit)
	end
end

function autoSwing.run(c, flight, plan, id, dt)
	local sw = S.swing
	if not sw or sw.id ~= id then
		sw = { id = id, target = randRange(-cfg.timingSpread, cfg.timingSpread) / 1000 }
		S.swing = sw
	end
	-- FIX: widen retry window slightly (0.15 -> 0.18) so we don't start a fresh
	-- swing attempt while the previous release animation is still settling
	if sw.released and sw.releasedAt and c.now - sw.releasedAt > 0.18 and swingReady(c) and not charging() and flight.landTime - c.now > 0.3 then
		sw = { id = id, target = sw.target, retry = true }
		S.swing = sw
	end
	-- Never call moveTo while airborne or while a jump is in progress.
	-- hum:MoveTo and holdKey(LeftShift) during the jump coil/apex breaks the smash animation.
	local inJump = sw.jumped or c.airborne
	if plan and cfg.autoMove and not sw.released and not inJump then
		local target, run = plan.stand, plan.sprint
		local far = flatDist(plan.stand, c.hrp.Position)
		-- Always sprint when more than 1.5 studs away — bot must arrive before pressing.
		if far > 1.5 then run = "force" end
		if plan.urgent then run = "force" end
		if sw.pressed and sw.kind ~= "JOH" then
			-- After pressing, track the live shuttle position so we follow it
			-- if it deviates from the predicted contact point.
			local live = sw.lastHit
			local tc = live and live.tc or plan.t
			if not live and c.now > plan.t - 0.05 then tc = c.now + 0.2 end
			local ok, p = pcall(G.physics.positionAt, flight, max(tc, c.now + 0.05))
			if ok and p then
				target = standFor(p, sw.kind or plan.kind, c)
				if flatDist(target, c.hrp.Position) > 1.0 then run = "force" end
			end
		end
		local d = moveTo(c, target, run)
		if d <= 1.0 and cfg.faceNet and not c.locked and not sw.pressed then faceNet(c, dt) end
	end
	-- Stop all movement while airborne so the sprint key doesn't interfere with landing.
	if c.airborne then stopMoving(c) end
	-- Clear jump state after landing. Also clear when released (smash fired mid-air) so the
	-- jump flag doesn't persist and block the next shot.
	if sw.jumped and (sw.released or (not c.airborne and c.now > sw.jumpAt + 0.45)) then
		if not sw.released then S.noJumpFor = id end
		sw.jumped, sw.lockedPlan, sw.kind, sw.pressed = nil, nil, nil, (sw.released and sw.pressed or false)
	end
	local free = cfg.autoSwing and plan and not sw.pressed and swingReady(c) and not charging()
	if free and sw.jumped and c.airborne then
		G.fn.press("OH")
		sw.pressed, sw.pressedAt = true, c.now
	elseif free and not sw.jumped then
		autoSwing.press(c, flight, plan, id, sw)
	end
	if sw.pressed and not sw.released and not charging() and c.now - sw.pressedAt > 0.15 then
		sw.pressed = false
		sw.refined, sw.refinedLate = nil, nil
	end
	if cfg.autoAim and sw.pressed and not sw.released and plan then
		if not sw.refined or (c.now - sw.refined >= 0.05 and S.searchDone == S.searchToken) then
			sw.refined = c.now
			refineAim(c, flight, sw)
		end
	end
	if cfg.autoAim and plan and sw.pressed and not sw.released and charging() and not S.urgentAim then
		local ok, good = pcall(actualShotOk, c, sw, { contact = plan.contact, tc = plan.t, err = 0 }, sw.predCharge or sw.plannedCharge)
		if ok and good == false then S.urgentAim = true end
	end
	if sw.pressed and not sw.released and charging() then autoSwing.release(c, flight, plan, id, sw) end
	if not plan and cfg.autoMove then
		-- For fast/short shots with no intercept plan: find the earliest reachable
		-- point in the trajectory so we intercept sooner rather than chasing the landing spot.
		-- Scan at 1/60s steps for precision; break on first point that's strictly closer to us.
		local bestTarget = flight.landPos
		local bestKind = "FH"
		local now = c.now
		local runSpeed = (G.config and G.config.SPRINT_SPEED) or 24
		if G.physics and G.physics.positionAt and G.config and G.config.SWING then
			local scanEnd = min(flight.landTime, now + 2.5)
			local t = now + 0.04
			local curDist = flatDist(standFor(bestTarget, bestKind, c), c.hrp.Position)
			while t <= scanEnd do
				local ok, p = pcall(G.physics.positionAt, flight, t)
				if ok and p and p.Z * c.dirZ < -0.1 then
					local h = p.Y - G.floorY
					local sw2 = G.config.SWING
					local kind2 = "FH"
					if sw2.OH then
						local lo = sw2.OH.hMin * G.SV + 0.25
						local hi = sw2.OH.hMax * G.SV
						if h >= lo and h <= hi then kind2 = "OH" end
					end
					local stand2 = standFor(p, kind2, c)
					local d2 = flatDist(stand2, c.hrp.Position)
					-- Take first point we can physically reach (run speed check) that's
					-- also closer than the landing spot — earliest interceptable moment.
					local canReach = d2 / runSpeed < (t - now) + 0.1
					if canReach and d2 < curDist + 0.5 then
						bestTarget, bestKind, curDist = p, kind2, d2
						break
					end
				end
				t = t + 1/60
			end
		end
		moveTo(c, standFor(bestTarget, bestKind, c), "force")
	end
	-- Dive logic: only dive when we genuinely can't reach the shuttle on foot.
	-- Never dive while airborne (post-jump-smash landing) — that's what causes the stuck animation.
	-- Never dive on our own outgoing shot (flight.team == c.team means we just hit it).
	-- Never dive on a serve return — stay on feet and play a controlled return.
	-- Never dive within 2.2s of a jump smash — the landing animation is still settling.
	local recentJump = S.lastJumpAt and (c.now - S.lastJumpAt) < 2.2
	if cfg.autoDive and S.diveFor ~= id and c.stamina >= G.config.DIVE_COST
		and not flight.isServe and not c.airborne and not recentJump and flight.team ~= c.team then
		local timeLeft    = flight.landTime - c.now
		local standTarget = plan and plan.stand or flight.landPos
		local distToTarget = flatDist(c.hrp.Position, standTarget)
		local runSpeed     = (G.config and G.config.SPRINT_SPEED) or (G.config and G.config.RUN_SPEED) or 24
		local canSprintThere = distToTarget / runSpeed < timeLeft - 0.1
		-- 5-stud minimum: never dive a shot the bot can reach with one or two steps.
		local trulyFar = distToTarget > 5.0
		-- 3 whiffs AND still genuinely far away (not a timing edge case near the shuttle).
		local whiffed  = (S.whiffCount[id] or 0) >= 3 and trulyFar
		-- Only dive when sprinting is still not fast enough AND shuttle lands soon.
		local shouldDive = (not canSprintThere and trulyFar and timeLeft > 0.1) or whiffed
		if shouldDive then autoSwing.dive(c, flight, id) end
	end
end

local logger = { buf = {}, file = "badminton_log.txt", anims = {}, lastPos = 0, lastFlush = 0, lastFlight = nil }

function logger.fmt(v)
	if typeof(v) == "Vector3" then return string.format("(%.1f,%.1f,%.1f)", v.X, v.Y, v.Z) end
	if type(v) == "number" then return string.format("%.3f", v) end
	return tostring(v)
end

function logger.add(tag, ...)
	if not cfg.logFile then return end
	local parts = { string.format("%.2f", workspace:GetServerTimeNow() % 10000), tag }
	for i = 1, select("#", ...) do parts[#parts + 1] = logger.fmt((select(i, ...))) end
	logger.buf[#logger.buf + 1] = table.concat(parts, " ")
end

function logger.flush()
	if #logger.buf == 0 then return end
	local text = table.concat(logger.buf, "\n") .. "\n"
	logger.buf = {}
	pcall(function()
		if isfile and isfile(logger.file) then appendfile(logger.file, text) else writefile(logger.file, text) end
	end)
end

function logger.watch(ch, who)
	local animator = ch and ch:FindFirstChildWhichIsA("Animator", true)
	if not animator or logger.anims[animator] then return end
	logger.anims[animator] = animator.AnimationPlayed:Connect(function(track)
		local anim = track.Animation
		logger.add("ANIM", who, ch.Name, track.Name ~= "" and track.Name or (anim and anim.AnimationId))
	end)
end

function logger.tick(c)
	if not cfg.logFile then return end
	local now = os.clock()
	local me = localPlayer.Character
	logger.watch(me, "me")
	for team = 1, 2 do
		for slot = 1, 2 do
			local ref = c.model:FindFirstChild("T" .. team .. "P" .. slot)
			local ch = ref and ref.Value
			if ch and ch ~= me then logger.watch(ch, team == c.team and "mate" or "opp") end
		end
	end
	if now - logger.lastPos >= 0.25 then
		logger.lastPos = now
		for team = 1, 2 do
			for slot = 1, 2 do
				local ref = c.model:FindFirstChild("T" .. team .. "P" .. slot)
				local root = ref and ref.Value and ref.Value:FindFirstChild("HumanoidRootPart")
				if root then logger.add("POS", "T" .. team .. "P" .. slot, ref.Value.Name, root.Position, root.AssemblyLinearVelocity) end
			end
		end
		logger.add("STATE", c.state, "stamina", c.stamina, "plan", S.plan and S.plan.kind, S.plan and S.plan.t - c.now)
	end
	local f = c.flight
	if f and f.id ~= logger.lastFlight then
		logger.lastFlight = f.id
		logger.add("SHOT", "id", f.id, "team", f.team, f.team == c.team and "us" or "them", f.shot, f.grade, "kmh", f.kmh, "serve", f.isServe, "from", f.p0, "land", f.landPos, "net", f.netHit, f.netKind, "in", landsIn(c, f.landPos, 0))
	end
	if now - logger.lastFlush >= 1 then
		logger.lastFlush = now
		logger.flush()
	end
end

hub.logger = logger
local nextScan = 0
local hookRemotes

local function step(dt)
	S.lastDt = dt
	if not okGame then
		if os.clock() < nextScan then return end
		nextScan = os.clock() + 3
		local okCall, result, msg = pcall(findGame)
		okGame = okCall and result
		hub.errors.load = not okGame and (okCall and msg or result) or nil
		if not okGame then return end
		-- Re-snapshot ORIG values now that findGame succeeded mid-session
		if G.config and not ORIG_STAMINA then
			ORIG_STAMINA = {
				STAMINA_REGEN       = G.config.STAMINA_REGEN,
				STAMINA_REGEN_DELAY = G.config.STAMINA_REGEN_DELAY,
				DIVE_COST           = G.config.DIVE_COST,
				SPRINT_DRAIN        = G.config.SPRINT_DRAIN,
				JUMP_STAMINA_BASE   = G.config.JUMP_STAMINA_BASE,
				JUMP_STAMINA_CHARGE = G.config.JUMP_STAMINA_CHARGE,
			}
		end
		hookRemotes()
	end

	-- Infinite stamina: patch Config table per-frame so the game's stamina system
	-- reads zero costs / instant regen. Restore originals when toggled off.
	if ORIG_STAMINA and G.config then
		if cfg.infiniteStamina then
			G.config.STAMINA_REGEN       = 99999
			G.config.STAMINA_REGEN_DELAY = 0
			G.config.DIVE_COST           = 0
			G.config.SPRINT_DRAIN        = 0
			G.config.JUMP_STAMINA_BASE   = 0
			G.config.JUMP_STAMINA_CHARGE = 0.001
		else
			G.config.STAMINA_REGEN       = ORIG_STAMINA.STAMINA_REGEN
			G.config.STAMINA_REGEN_DELAY = ORIG_STAMINA.STAMINA_REGEN_DELAY
			G.config.DIVE_COST           = ORIG_STAMINA.DIVE_COST
			G.config.SPRINT_DRAIN        = ORIG_STAMINA.SPRINT_DRAIN
			G.config.JUMP_STAMINA_BASE   = ORIG_STAMINA.JUMP_STAMINA_BASE
			G.config.JUMP_STAMINA_CHARGE = ORIG_STAMINA.JUMP_STAMINA_CHARGE
		end
	end

	local c = context()
	if not c then
		S.view = nil
		if S.moving then S.moving = false; holdKey(Enum.KeyCode.LeftShift, false) end
		return
	end
	hub.ctx = c
	logger.tick(c)
	if c.oppJump then
		S.oppJumpAt = c.now
		-- Pre-hold: opponent just jumped AND was near the net (anim hook confirmed it).
		-- Start holding the swing button now, before the shot registers, so reaction
		-- delay is absorbed by the hold wind-up. Only fires if we have a previous plan
		-- to base the contact on and aren't already swinging.
		if cfg.autoPlay and cfg.autoDive and S.oppNearNet
			and S.oppJumpAt and (c.now - S.oppJumpAt) < 0.15
			and not (S.swing and S.swing.pressed) then
			local plan = S.plan
			if plan then
				local kind = plan.kind == "JOH" and "OH" or (plan.kind or "OH")
				local preAction = actionFor(c, kind)
				G.fn.press(preAction)
				S.swing = { id = plan.id or 0, kind = kind, pressedAt = c.now, pressed = true, preHold = true, target = 0 }
				S.preHeld = true
			end
		end
	end
	local flight = c.flight
	local view = { status = "", state = c.state, now = c.now }
	S.view = view

	if flight and flight.pts and flight.landPos and flight.landTime > c.now - 0.3 then
		view.flight = flight
		view.land = flight.landPos
		view.landTime = flight.landTime
		view.netHit = flight.netHit
		view.landIn = landsIn(c, flight.landPos, 0)
		if flight.isServe then
			local okIn, inBox = pcall(G.physics.inServiceCourt, flight.landPos, c.model:GetAttribute("ServeSign") or 1, c.cx, c.doubles)
			if okIn then view.landIn = inBox end
		end
		view.mine = flight.team == c.team
		recordFlight(c, flight)
	end

	local pending = up.get("swing", 16)
	-- FIX: extend the stale-flight tolerance from 0 to 0.12s so very fast short drops
	-- don't fall out of the incoming window before the bot can react to them.
	local incoming = flight and c.state == "Rally" and flight.team ~= c.team and not flight.netHit and flight.landTime > c.now - 0.12 and flight.landTime < c.now + 10 and pending == nil
	view.incoming = incoming
	local clearlyOut = incoming and view.landIn == false and (flight.isServe or not landsIn(c, flight.landPos, -0.25))
	view.leave = clearlyOut
	-- Track when opponent plays a cord so we can boost our own cord chance on the follow-up.
	-- A cord from the opponent means their shot has netKind="cord" and it landed on our side.
	if incoming and flight and flight.netKind == "cord" and not S.lastReceivedCord then
		S.lastReceivedCord = c.now
	elseif not incoming then
		-- Clear stale cord flag if no incoming shot (between rallies)
		if S.lastReceivedCord and c.now - S.lastReceivedCord > 3.0 then
			S.lastReceivedCord = nil
		end
	end

	-- FIX: clean up stale whiff counts for flights we're no longer tracking
	if flight then
		for fid in pairs(S.whiffCount) do
			if fid ~= flight.id then S.whiffCount[fid] = nil end
		end
	end

	if incoming then
		local id = flight.id
		if not S.seen[id] then
			S.seen[id] = c.now
			local start = cfg.earlyRead and c.now or max(c.now, flight.t0)
			local react = randRange(cfg.reactionMin, max(cfg.reactionMin, cfg.reactionMax)) / 1000
			local smash = (S.oppJumpAt and c.now - S.oppJumpAt < 0.8) or flight.landTime - flight.t0 < 0.9
			if smash then react = react * 0.4; S.smashFor = id end
			S.react[id] = start + react
			S.aim = nil
			S.plan = nil
		end
		local readyAt = S.react[id]
		local plan
		local committed = S.swing
		if committed and committed.id == id and committed.lockedPlan and not committed.released then
			plan = committed.lockedPlan
		elseif c.airborne then
			-- Bot is getting up from a dive. Can't swing yet, but MUST start moving
			-- toward the next shot immediately — post-dive freeze is the main weakness.
			-- Move toward the trajectory intercept if we can compute one, otherwise land pos.
			if cfg.autoMove then
				local earlyPlan = planIntercept(c, flight, c.now + 0.3, true, true)
				local moveTarget = earlyPlan and earlyPlan.stand or standFor(flight.landPos, "FH", c)
				moveTo(c, moveTarget, "force")
			end
			plan = nil
		else
			plan = planIntercept(c, flight, readyAt) or planIntercept(c, flight, readyAt, true) or planIntercept(c, flight, readyAt, true, true)
			-- FIX: for short/fast drops planIntercept may fail because readyAt > landTime
			-- (reaction delay eats the window). Try again with readyAt = now so the bot
			-- at least moves to the ball and dives rather than standing still.
			if not plan and flight.landTime - c.now < 1.1 and flight.landTime > c.now then
				plan = planIntercept(c, flight, c.now) or planIntercept(c, flight, c.now, true) or planIntercept(c, flight, c.now, true, true)
				if plan then plan.urgent = true end  -- tag so we skip press delay below if needed
			end
		end
		if plan then
			if S.swing and S.swing.id == id and S.swing.kind then plan.kind = S.swing.kind end
			S.plan = plan
			view.plan = plan
			local sw0 = S.swing
			local committedSwing = sw0 and sw0.id == id and sw0.pressed
			local moved = S.searchContact and ((S.searchContact - plan.contact).Magnitude > 3 or S.searchTap ~= isNetTap(plan.contact) or S.searchKind ~= plan.kind)
			if (cfg.autoAim or cfg.aimMarker) and ((S.searchFor ~= id) or (moved and not committedSwing)) then
				S.searchFor = id
				S.searchContact, S.searchTap, S.searchKind = plan.contact, isNetTap(plan.contact), plan.kind
				if moved then S.aim = nil end
				-- Context-aware cord attempt:
				-- Only try cords on net taps (contact near net), never on clears/smashes/serves.
				-- Boost chance when bot is already close to the net (<=10 studs), since that's
				-- when real cords happen. Also boost after receiving a cord ourselves — if the
				-- opponent just played a cord, our return is likely another tight net shot.
				do
					local isTap = isNetTap(plan.contact)
					local botZ = c.hrp and c.hrp.Position.Z or 999
					local nearNet = abs(botZ) < 10  -- within ~10 studs of net
					local cordAfterCord = S.lastReceivedCord and (c.now - S.lastReceivedCord) < 2.0
					local effectiveChance = 0
					if isTap then
						effectiveChance = cfg.netCordChance
						if nearNet then effectiveChance = min(effectiveChance * 1.8, 100) end
						if cordAfterCord then effectiveChance = min(effectiveChance * 1.4, 100) end
					end
					S.cordTry = math.random(100) <= effectiveChance
				end
				-- On serve receive: use a soft-touch charge set and prefer backhand placement
				-- (short, low net drop or tight backhand cross). Never smash a serve.
				local serveReceive = flight.isServe
				local receiveCharges = serveReceive and { 0.18, 0.12, 0.25, 0.08 } or nil
				local receiveStyle = serveReceive and "Net" or styleFor(id)
				local charges = receiveCharges or (S.smashFor == id and { 0.25, 0.15, 0.35 } or chargeOptions(plan.kind, plan.contact, receiveStyle))
				-- Post-dive: floor all charges to 0.65 so the shuttle reaches the back of the
				-- court from a floor-level contact. Low charge + flat pitch = net or short court.
				local isDiveRecovery = S.divedAt and (c.now - S.divedAt) < 3.0
				if isDiveRecovery and not serveReceive then
					for i, ch in ipairs(charges) do
						if ch < 0.65 then charges[i] = 0.65 end
					end
				end
				-- Anti-smash-spam lift: if opponent has been near the net recently (spamming net kills),
				-- force a high, deep clear to push them back — flag tells searchAim to reward deep+high arcs.
				local oppSpammingNet = S.oppNearNetAt and (c.now - S.oppNearNetAt) < 3.5
				searchAim(c, { id = id, kind = plan.kind, contact = plan.contact, t = plan.t, charges = charges, style = receiveStyle, defModel = defenderGet(c), serveReceive = serveReceive, liftClear = oppSpammingNet })
			end
		else
			S.plan = nil
		end
		view.aim = S.aim and S.aim.id == id and S.aim or nil

		if c.mate and plan and S.mateCall ~= id and S.mineCall ~= id then
			local mine = flatDist(plan.stand, c.hrp.Position)
			local theirs = flatDist(plan.contact, c.mate)
			if theirs + 2 < mine then S.mateCall = id else S.mineCall = id end
		end
		local mateTakes = c.mate and S.mateCall == id and not (S.swing and S.swing.id == id and S.swing.pressed)
		view.mateTakes = mateTakes
		local auto = cfg.autoPlay and not (cfg.leaveOut and clearlyOut) and not mateTakes
		if cfg.autoPlay and mateTakes and cfg.autoMove then moveTo(c, basePosition(c), false) end

		-- Net-hugging: if bot is near the net and the shuttle lands deep on our side,
		-- sprint back to base first. dirZ < 0 means bot plays toward -Z (court normal).
		-- Bot is "near net" if |botZ| < 25% of half-court length.
		-- Only retreat if NOT already committed (swing pressed).
		local halfL = G.halfL or 15
		local botZ = c.hrp.Position.Z
		local landZ = flight.landPos.Z
		-- bot's net side: if dirZ < 0, bot plays toward negative Z; net is at ~Z=0
		-- so bot's own half is on the -Z side, net is at 0, baseline is at -halfL*dirZ
		local nearNet = abs(botZ) < halfL * 0.28
		local landDeep = abs(landZ) > halfL * 0.45  -- landing in back 55% of court
		local landOnMySide = landZ * c.dirZ < 0  -- land pos is on bot's side of net
		local mustRetreat = S.servedShort and nearNet and landOnMySide and (not plan or flatDist(plan.stand, c.hrp.Position) > 5)
		if mustRetreat and cfg.autoMove and not (S.swing and S.swing.id == id and S.swing.pressed) then
			moveTo(c, basePosition(c), "force")
		elseif auto and not plan and cfg.autoMove and not (S.swing and S.swing.id == id and S.swing.pressed) then
			-- FIX: same sweet-spot offset fix for the outer autoPlay fallback move
			local landH2 = flight.landPos.Y - G.floorY
			local fbKind2 = "FH"
			if G.config and G.config.SWING and G.config.SWING.OH then
				local ohSW = G.config.SWING.OH
				if landH2 >= ohSW.hMin * G.SV + 0.3 and landH2 <= ohSW.hMax * G.SV then fbKind2 = "OH" end
			end
			moveTo(c, standFor(flight.landPos, fbKind2, c), "force")
		end
		if auto and c.now >= readyAt then
			autoSwing.run(c, flight, plan, id, dt)
		end
		view.status = mateTakes and "PARTNER" or (plan and string.format("%s in %.2fs", plan.kind == "JOH" and "JUMP SMASH" or plan.kind, plan.t - c.now) or (clearlyOut and "LEAVE" or "DIVE?"))
	else
		local sw = S.swing
		-- Release any pre-hold swing if the smash never came (opponent faked the jump).
		-- A pre-hold swing has id=0 and there's no incoming shot to match it.
		if S.preHeld and sw and sw.preHold then
			if charging() then
				G.fn.release(actionFor(c, sw.kind == "JOH" and "OH" or sw.kind or "OH"))
			end
			S.swing = nil
			S.preHeld = false
		elseif cfg.autoPlay and sw and sw.pressed and not sw.released and charging() then
			sw.released = true
			withAim(nil, G.fn.release, actionFor(c, sw.kind == "JOH" and "OH" or sw.kind or "OH"))
		end

		-- Always return to base between shots so the bot is pre-positioned and
		-- can reach any part of the court quickly when the next shot comes in.
		if cfg.autoPlay and cfg.autoMove and cfg.returnBase and c.state == "Rally" then
			local base = basePosition(c)
			if S.oppJumpAt and c.now - S.oppJumpAt < 1.2 then S.driftAt = nil end
			-- After a short serve sprint back; clear flag once at base.
			local distToBase = flatDist(c.hrp.Position, base)
			local sprintBack = S.servedShort and distToBase > 2.0
			if S.servedShort and distToBase < 1.5 then S.servedShort = false end
			-- Sprint back to base whenever more than 3 studs away (not just after short serve)
			-- so the bot constantly self-corrects its position between rallies.
			-- With infinite stamina, always sprint back — no cost, maximum readiness.
			local needsSprint = distToBase > 3.0 or cfg.infiniteStamina
			moveTo(c, base, (sprintBack or needsSprint) and "force" or false)
		elseif cfg.autoPlay and cfg.autoMove and c.state == "ServeReady" and c.model:GetAttribute("ReceiverId") == localPlayer.UserId then
			local pos = c.hrp.Position
			moveTo(c, v3(pos.X, 0, -c.dirZ * (G.config.SHORT_SERVICE + 2)), false)
		elseif S.moving and not (cfg.autoPlay and cfg.autoMove and cfg.returnBase) then
			stopMoving(c)
		end
		view.status = (c.state or "") .. (c.vsBot and " | vs bot" or " | vs player") .. (c.doubles and " | doubles" or " | singles")
	end

	if not cfg.autoPlay and (cfg.releaseAssist or cfg.autoAim) and incoming then
		local held = charging()
		if held then
			local sw = S.swing
			if not sw or sw.id ~= flight.id or sw.manual ~= held then
				local startAt = held == "OH" and up.get("startCharge", 5) or up.get("startSideCharge", 8)
				sw = { id = flight.id, kind = held, pressedAt = startAt or c.now, pressed = true, manual = held, target = randRange(-cfg.timingSpread, cfg.timingSpread) / 1000 }
				S.swing = sw
				if cfg.autoAim then refineAim(c, flight, sw) end
			end
			if cfg.releaseAssist and not sw.released and tryRelease(c, flight, held, sw.pressedAt, sw.target) then
				sw.released = true
				local aim = (cfg.autoAim and S.aim and S.aim.id == flight.id) and S.aim or nil
				withAim(aim, G.fn.release, G.hand.stroke(held, c.isLeft))
			end
		end
	end

	S.aimOffset = G.settings.get("AimOffset") or 0
	local camTarget
	if cfg.autoAim and incoming then
		local aim = S.aim and S.aim.id == flight.id and S.aim or nil
		local sw = S.swing
		local released = sw and sw.id == flight.id and sw.released
		local soon = S.plan and S.plan.t - c.now < 1.1
		if aim and not released and (cfg.autoPlay or charging() or soon) then
			camTarget = aimTarget(aim, c.dirZ)
		end
	end
	if S.serving and S.serveTarget then camTarget = S.serveTarget end
	S.camTarget = camTarget

	if cfg.autoServe and c.state == "ServeReady" and c.model:GetAttribute("ServerId") == localPlayer.UserId then
		runServe(c)
	end
	view.serveAim = S.serving and S.serveAim or nil
	view.stamina = c.stamina
	view.cx, view.halfW, view.dirZ = c.cx, c.halfW, c.dirZ
end

local function onRallyEnd(args)
	if type(args) ~= "table" then return end
	local court = localPlayer:GetAttribute("Court") or 0
	local team = localPlayer:GetAttribute("Team") or 0
	if args.court ~= court or team == 0 then return end
	if args.winner == team and args.reason == "IN" and typeof(args.land) == "Vector3" then
		local halfW = hub.ctx and hub.ctx.halfW or G.config.SINGLES_HALF_WIDTH
		local ix, iz = cellOf(args.land.X, args.land.Z, G.courts.cx(max(court, 1)), halfW)
		tracker.theirs[ix][iz] = tracker.theirs[ix][iz] + 1
		tracker.theirsTotal = tracker.theirsTotal + 1
	end
	logger.add("RALLY", "winner", args.winner, args.winner == team and "us" or "them", "reason", args.reason, "land", args.land)
	-- Track win/loss in defender model so we can gauge if learning is helping
	if cfg.learnDefender then
		local c = hub.ctx
		local dm = c and defenderGet(c)
		if dm then
			if args.winner == team then dm.ralliesWon = dm.ralliesWon + 1
			else dm.ralliesLost = dm.ralliesLost + 1 end
		end
	end
	-- FIX: also clear whiff counts on rally end so stale counts don't bleed into next rally
	S.whiffCount = {}
	S.seen, S.react = {}, {}
	S.lastReceivedCord = nil  -- clear cord boost between rallies
	S.divedAt = nil           -- clear post-dive sprint flag between rallies
	S.oppNearNetAt = nil      -- clear net-spam tracking between rallies
	S.preHeld = false         -- clear pre-hold state between rallies
	S.lastJumpAt = nil        -- clear jump-smash cooldown between rallies
end

function hookRemotes()
	if hub.remotesHooked then return end
	hub.remotesHooked = true
	local remotes = game:GetService("ReplicatedStorage"):WaitForChild("Badminton"):WaitForChild("Remotes")
	connect(remotes.RallyEnd.OnClientEvent, function(args)
		local ok, err = pcall(onRallyEnd, args)
		if not ok then hub.errors.rally = err end
	end)
	connect(remotes.Anim.OnClientEvent, function(ch, name)
		if typeof(ch) ~= "Instance" or type(name) ~= "string" then return end
		local c = hub.ctx
		local who = ch == localPlayer.Character and "me" or "other"
		if c and c.opps then
			for _, o in ipairs(c.opps) do if o.char == ch then who = "opp" end end
		end
		logger.add("ANIM", who, ch.Name, name)
		if who ~= "opp" then return end
		local root = ch:FindFirstChild("HumanoidRootPart")
		local up_str = string.upper(name)
		if string.find(up_str, "OH") or string.find(up_str, "JUMP") or string.find(up_str, "SMASH") then
			S.oppJumpAt = workspace:GetServerTimeNow()
			S.oppNearNet = root and abs(root.Position.Z) < 12 or false
			-- Track when opponent is persistently near the net while smashing —
			-- used to decide to lift/clear rather than return short, to push them back.
			if S.oppNearNet then S.oppNearNetAt = S.oppJumpAt end
		end
	end)
end
if okGame then hookRemotes() end

