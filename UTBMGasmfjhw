function hub.Unload()
	if not hub.alive then return end
	hub.alive = false
	pcall(function() for _, con in pairs(logger.anims) do con:Disconnect() end logger.flush() end)
	pcall(function() RunService:UnbindFromRenderStep(renderName) end)
	for _, c in ipairs(connections) do pcall(function() c:Disconnect() end) end
	for key, on in pairs(held) do if on then pcall(function() VirtualInputManager:SendKeyEvent(false, key, false, game) end) end end
	-- Restore stamina config on unload so we don't leave the game patched
	pcall(function()
		if ORIG_STAMINA and G.config then
			G.config.STAMINA_REGEN       = ORIG_STAMINA.STAMINA_REGEN
			G.config.STAMINA_REGEN_DELAY = ORIG_STAMINA.STAMINA_REGEN_DELAY
			G.config.DIVE_COST           = ORIG_STAMINA.DIVE_COST
			G.config.SPRINT_DRAIN        = ORIG_STAMINA.SPRINT_DRAIN
			G.config.JUMP_STAMINA_BASE   = ORIG_STAMINA.JUMP_STAMINA_BASE
			G.config.JUMP_STAMINA_CHARGE = ORIG_STAMINA.JUMP_STAMINA_CHARGE
		end
	end)
	if okGame then
		pcall(function()
			if type(up.get("aimAngles", 1)) == "table" then up.set("aimAngles", 1, nil) end
		end)
		pcall(function()
			local c = hub.ctx
			if S.moving and c and c.hum and c.hum.Parent then c.hum:MoveTo(c.hrp.Position) end
		end)
	end
	for d in pairs(drawings) do pcall(function() d:Remove() end) end
	table.clear(drawings)
	if env.BadmintonHub == hub then env.BadmintonHub = nil end
	if env.AuralV2Lib and _auralWindow then pcall(function() _auralWindow:Destroy() end) end
end
