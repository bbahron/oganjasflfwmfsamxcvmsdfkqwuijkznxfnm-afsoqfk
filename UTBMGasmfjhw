local function resetTracker()
	for side = 1, 2 do
		local t = side == 1 and tracker.theirs or tracker.mine
		for i = 1, GRID do
			t[i] = {}
			for j = 1, GRID do t[i][j] = 0 end
		end
	end
	tracker.theirsTotal, tracker.mineTotal = 0, 0
end
resetTracker()

local function cellOf(x, z, cx, halfW)
	local ix = clamp(floor((x - cx + halfW) / (2 * halfW) * GRID) + 1, 1, GRID)
	local iz = clamp(floor(abs(z) / G.halfL * GRID) + 1, 1, GRID)
	return ix, iz
end

local held = {}
local function holdKey(key, on)
	if (held[key] or false) == on then return end
	held[key] = on
	pcall(function() VirtualInputManager:SendKeyEvent(on, key, false, game) end)
end

local function context()
	local c = { now = workspace:GetServerTimeNow() }
	c.team = localPlayer:GetAttribute("Team") or 0
	c.court = localPlayer:GetAttribute("Court") or 0
	if c.team == 0 or c.court == 0 then return nil end
	c.model = G.courtsFolder:FindFirstChild("Court" .. c.court)
	if not c.model then return nil end
	c.state = c.model:GetAttribute("State")
	c.doubles = c.model:GetAttribute("Mode") == "Doubles"
	c.dirZ = c.team == 2 and -1 or 1
	c.cx = G.courts.cx(max(c.court, 1))
	local char = localPlayer.Character
	c.hum = char and char:FindFirstChildOfClass("Humanoid")
	c.hrp = char and char:FindFirstChild("HumanoidRootPart")
	if not c.hum or not c.hrp or c.hum.Health <= 0 then return nil end
	c.feet = G.rig.feet(c.hum, c.hrp)
	c.airborne = c.feet.Y - G.floorY > 0.5
	c.hand = G.hand.sign(localPlayer)
	c.isLeft = G.hand.isLeft(localPlayer)
	local st = G.states[c.court]
	c.flight = st and st.current
	c.stamina = up.get("dive", 6) or 100
	c.halfW = c.doubles and G.config.DOUBLES_HALF_WIDTH or G.config.SINGLES_HALF_WIDTH
	c.mate = nil
	if c.doubles then
		for slot = 1, 2 do
			local ref = c.model:FindFirstChild("T" .. c.team .. "P" .. slot)
			local ch = ref and ref.Value
			local root = ch and ch ~= localPlayer.Character and ch:FindFirstChild("HumanoidRootPart")
			if root then c.mate = root.Position end
		end
	end
	c.opps = {}
	for slot = 1, 2 do
		local ref = c.model:FindFirstChild("T" .. (3 - c.team) .. "P" .. slot)
		local ch = ref and ref.Value
		local root = ch and ch:FindFirstChild("HumanoidRootPart")
		if root then
			local vy = root.AssemblyLinearVelocity.Y
			if vy > 6 or root.Position.Y - G.floorY > 4.6 then c.oppJump = true end
			c.vsBot = c.vsBot or Players:GetPlayerFromCharacter(ch) == nil
			c.opps[#c.opps + 1] = { pos = root.Position + flat(root.AssemblyLinearVelocity) * 0.2, char = ch }
		end
	end
	if #c.opps == 0 then
		c.opps[1] = { pos = v3(c.cx, 0, c.dirZ * G.halfL * 0.45) }
	end
	c.locked = game:GetService("UserInputService").MouseBehavior == Enum.MouseBehavior.LockCenter
	local look = flat(camera.CFrame.LookVector)
	c.camFwd = look.Magnitude > 1e-3 and look.Unit or v3(0, 0, c.dirZ)
	return c
end

