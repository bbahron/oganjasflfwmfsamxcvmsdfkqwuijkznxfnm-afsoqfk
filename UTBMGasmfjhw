				if not toasts or not toasts.Parent then return end
				local ap = chatFrame.AbsolutePosition
				local as = chatFrame.AbsoluteSize
				toasts.Position = UDim2.fromOffset(
					math.floor(ap.X) + 12,
					math.floor(ap.Y + as.Y) + 8
				)
