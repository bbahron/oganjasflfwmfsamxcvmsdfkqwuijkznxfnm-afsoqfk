local G = {}

local function findGame()
	local fns = {}
	for _, f in ipairs(getgc(false)) do
		if type(f) == "function" and islclosure(f) then
			local ok, src, name = pcall(debug.info, f, "sn")
			if ok and src and name and name ~= "" and string.find(src, "BadmintonClient%.Client$") then
				if not fns[name] then fns[name] = f end
			end
			if ok and src and (name == nil or name == "") and string.find(src, "BadmintonClient%.Client$") then
				local ups = debug.getupvalues(f)
				local top = 0
				for i in pairs(ups) do if i > top then top = i end end
				if top >= 70 and top <= 90 then fns.__render = f end
			end
		end
	end
	for _, n in ipairs({ "swing", "press", "release", "dive", "planDive", "aimAngles", "serveContact", "startSideCharge", "startCharge" }) do
		if not fns[n] then return false, "missing " .. n end
	end
	G.fn = fns
	for _, v in pairs(debug.getupvalues(fns.swing)) do
		if type(v) == "table" then
			if rawget(v, "simulate") and rawget(v, "positionAt") then G.physics = v
			elseif rawget(v, "detect") then G.hitDetect = v
			elseif rawget(v, "resolve") and rawget(v, "gradeTiming") then G.resolver = v
			elseif rawget(v, "cx") and rawget(v, "halfZ") then G.courts = v
			elseif rawget(v, "feet") and rawget(v, "attachRacket") then G.rig = v
			elseif rawget(v, "stroke") and rawget(v, "sign") then G.hand = v
			elseif rawget(v, "height") and rawget(v, "at") then G.jumpMotion = v
			elseif rawget(v, "SWING") and rawget(v, "GRAVITY") then G.config = v
			else
				local first = next(v)
				if type(first) == "number" and type(v[first]) == "table" and rawget(v[first], "flights") then G.states = v end
			end
		elseif typeof(v) == "Instance" and v.Name == "Courts" and v:FindFirstChild("Court1") then
			G.courtsFolder = v
		end
	end
	for _, v in pairs(debug.getupvalues(fns.startSideCharge)) do
		if type(v) == "table" and rawget(v, "get") and not rawget(v, "actionFor") then G.settings = v end
	end
	for _, k in ipairs({ "physics", "hitDetect", "resolver", "courts", "rig", "hand", "jumpMotion", "config", "states", "courtsFolder", "settings" }) do
		if not G[k] then return false, "missing " .. k end
	end
	local cf = G.config
	G.SR, G.SV, G.simDt, G.floorY = cf.SR, cf.SV, cf.SIM_DT, cf.FLOOR_Y
	G.halfL = cf.HALF_LENGTH
	local apexT, apexH = 0, -1
	local js = { charge = 1, max = true, t0 = 0, height = G.jumpMotion.height(1) }
	for i = 0, 120 do
		local h = G.jumpMotion.at(js, i * 0.01)
		if h > apexH then apexH, apexT = h, i * 0.01 end
	end
	G.jumpApexT, G.jumpApexH = apexT, apexH
	G.jumpLead = max(cf.JUMP_COIL_T, cf.JUMP_CHARGE_TIME) + (cf.JUMP_WINDUP - cf.JUMP_COIL_T)
	return true
end

