local function chargeTime(kind, airborne)
	local cf, gs = G.config, G.settings
	if kind == "OH" or kind == "JOH" then
		return cf.overheadChargeTime(gs.get("OverheadChargeTime"), airborne)
	end
	return cf.sideChargeTime(gs.get("SideChargeTime"))
end

local function sweetFor(kind, charge)
	if kind == "OH" or kind == "JOH" then return G.config.SWING.OH.sweet end
	return G.resolver.sideSweet(charge)
end

local function standFor(p, kind, c)
	local sw = G.config.SWING[kind == "JOH" and "OH" or kind]
	local fwd = c.locked and c.camFwd or v3(0, 0, c.dirZ)
	local right = fwd:Cross(Vector3.yAxis) * c.hand
	local s = p - right * (sw.right * G.SR) - fwd * (sw.fwd * G.SR)
	local runoff = G.config.RUNOFF or 4
	local x = clamp(s.X, c.cx - c.halfW - runoff, c.cx + c.halfW + runoff)
	local depth = clamp(-c.dirZ * s.Z, 1.2, G.halfL + runoff)
	return v3(x, s.Y, -c.dirZ * depth)
end

local function planIntercept(c, flight, readyAt, forceSprint, loose)
	local cf = G.config
	local pos = c.hrp.Position
	local walk, sprint = cf.WALK_SPEED, cf.SPRINT_SPEED
	-- After a dive, ignore stamina reserve for 2.5s so the bot sprints to the next shot
	-- even with low stamina. Without this, post-dive the bot walks and can't cover deep replies.
	-- With infinite stamina, always treat stamina as full so sprint is never blocked.
	local postDive = S.divedAt and (c.now - S.divedAt) < 2.5
	local effStamina = cfg.infiniteStamina and 100 or c.stamina
	local canSprint = cfg.sprintMode ~= "Never" and effStamina > (forceSprint and 3 or (postDive and 3 or cfg.staminaReserve + 1))
	local canJump = cfg.jumpSmash and not c.airborne and S.noJumpFor ~= flight.id and c.stamina >= cf.JUMP_STAMINA_BASE + cf.JUMP_STAMINA_CHARGE + 6
	local floorY = c.airborne and G.floorY or c.feet.Y
	local startAt = max(max(c.now, readyAt) + 0.04, flight.t0 + 0.02)
	local kinds = { "JOH", "OH", "FH", "BH" }
	local SV, SR = G.SV, G.SR
	local t = startAt
	local endAt = min(flight.landTime, startAt + 4)
	if endAt ~= endAt then return nil end
	-- Use finer scan step (1/60s instead of 1/30s) so fast shots don't slip through
	-- the scan gaps. Only costs ~2x more iterations but catches optimal windows on drives/smashes.
	local scanStep = 1 / 60
	while t <= endAt do
		local p = G.physics.positionAt(flight, t)
		-- Relax the net-side check from -0.3 to -0.05 so net-tight returns
		-- (landing just past the net on our side) are included in intercept planning.
		if p.Z * c.dirZ <= -0.05 then
			local h = p.Y - floorY
			local best, bestScore
			for _, kind in ipairs(kinds) do
				local sw = cf.SWING[kind == "JOH" and "OH" or kind]
				local lift = kind == "JOH" and G.jumpApexH * 0.95 or 0
				-- Never jump-smash a net-tight shuttle: contact within 11 studs of net at low height
				-- means it's a net drop/lift situation. Jumping to smash sends it out of bounds.
				local netTightContact = abs(p.Z) < 11 and p.Y < (G.config.NET_H_POST + G.floorY + 1.5)
				local allowed = (kind ~= "JOH" or (canJump and not netTightContact)) and (kind ~= "OH" or not c.airborne)
				local lo = kind == "JOH" and sw.hMax * SV - 0.3 or sw.hMin * SV + lift + 0.25
				if allowed and h >= max(lo, abs(p.Z) < 11 and 1.2 or 0.4) and h <= sw.hMax * SV + lift - 0.25 then
					local stand = standFor(p, kind, c)
					-- Minimal sweet-spot discount: bot must actually reach the stand point.
					-- Old * 0.5 made the scan accept plans the bot couldn't execute in time.
					local d = max(flatDist(stand, pos) - sw.sweetR * SR * 0.1, 0)
					local deadline = kind == "JOH" and (t - G.jumpLead - G.jumpApexT) or t
					local avail = deadline - max(c.now, readyAt) - 0.05
					local useSprint = false
					-- Try sprint first if walk won't get there — sprint should be the default for
					-- any shot that requires more than a quick step, not a last resort.
					local fits = (d <= 0.35 and avail > -0.03) or d / walk <= avail
					if not fits and d / sprint <= avail then fits, useSprint = true, true end
					-- Even if walk fits, prefer sprint for farther shots so we arrive with margin.
					if fits and not useSprint and d > 2.5 and canSprint then useSprint = true end
					if fits and kind ~= "JOH" and not loose then
						local fwd = c.locked and c.camFwd or v3(0, 0, c.dirZ)
						local okD, hit = pcall(G.hitDetect.detect, {
							flight = flight, kind = kind, tp = t - sweetFor(kind, 0.4),
							feet = v3(stand.X, floorY, stand.Z), right = fwd:Cross(Vector3.yAxis) * c.hand,
							fwd = fwd, dirZ = c.dirZ, sweet = sweetFor(kind, 0.4), vel = Vector3.zero,
						})
						if okD and not hit then fits = false end
					end
					if fits then
						local score = -d
						if kind == "JOH" then score = score + 100 end
						if kind == "OH" and cfg.preferOverhead then score = score + 50 end
						if not bestScore or score > bestScore then
							bestScore = score
							-- With infinite stamina always sprint — no cost and covers distance faster.
						local sprintVal = (cfg.infiniteStamina or useSprint) and (forceSprint and "force" or true) or false
						best = { t = t, kind = kind, stand = stand, contact = p, sprint = sprintVal, dist = d, id = flight.id }
						end
					end
				end
			end
			if best then return best end
		end
		t = t + scanStep
	end
	return nil
end

local function detectAt(c, flight, kind, tp, sweet)
	local look = flat(c.hrp.CFrame.LookVector)
	local right = flat(c.hrp.CFrame.RightVector)
	look = look.Magnitude > 1e-4 and look.Unit or v3(0, 0, 1)
	right = right.Magnitude > 1e-4 and right.Unit or v3(1, 0, 0)
	return G.hitDetect.detect({
		flight = flight,
		kind = kind,
		tp = tp,
		feet = c.feet,
		right = right * c.hand,
		fwd = look,
		dirZ = c.dirZ,
		sweet = sweet,
		vel = c.hrp.AssemblyLinearVelocity,
		jump = c.airborne and up.get("swing", 10) or nil,
	})
end

hub.debug = { G = G, context = context, detectAt = detectAt, planIntercept = planIntercept, up = up }

local function oppSlack(c, sim)
	local pts = sim.pts
	local best = -huge
	local dt = G.simDt
	for i = 1, #pts, 5 do
		local p = pts[i]
		if p.Z * c.dirZ > 0 then
			local h = p.Y - G.floorY
			if h > 0.3 and h < 9.5 then
				local arrive = sim.t0 + (i - 1) * dt - c.now
				for _, o in ipairs(c.opps) do
					local d = max(flatDist(p, o.pos) - 4.2, 0)
					local slack = arrive - (d / 21 + 0.18)
					if slack > best then best = slack end
				end
			end
		end
	end
	return best
end

local lineWidth = 0.22
local function landsIn(c, pos, marginStuds)
	local x = abs(pos.X - c.cx)
	local z = abs(pos.Z)
	local hw, hl = c.halfW, G.halfL
	if not c.doubles then
		hw, hl = hw - lineWidth, hl - lineWidth
		return x < hw - marginStuds and z < hl - marginStuds
	end
	return x <= hw - marginStuds and z <= hl - marginStuds
end

local function trackerBonus(c, land)
	if not cfg.useTracker or tracker.theirsTotal < 3 then return 0 end
	local ix, iz = cellOf(land.X, land.Z, c.cx, c.halfW)
	local peak = 0
	for i = 1, GRID do for j = 1, GRID do peak = max(peak, tracker.theirs[i][j]) end end
	if peak == 0 then return 0 end
	return 0.25 * tracker.theirs[ix][iz] / peak
end

local function isNetTap(contact)
	if not contact then return false end
	return abs(contact.Z) < 11 and contact.Y < G.config.NET_H_POST + G.floorY + 1.2
end

local mixedStyles = { "Balanced", "Aggressive", "Defensive", "Net" }

local function styleFor(id)
	if cfg.playStyle ~= "Mixed" then return cfg.playStyle end
	S.mixed = S.mixed or {}
	if not S.mixed[id] then S.mixed[id] = mixedStyles[math.random(1, #mixedStyles)] end
	return S.mixed[id]
end

local function chargeOptions(kind, contact, style)
	local power = cfg.power / 100
	local overhead = kind == "OH" or kind == "JOH"
	if isNetTap(contact) then
		-- Net shots need meaningful charge to reach mid/back court on the other side.
		-- Old { 0.45, 0.35, 0.25, 0.55 } had 0.25 pulling the resolver toward short court.
		-- New set floors at 0.40 so even the weakest option clears comfortably.
		return { 0.55, 0.65, 0.45, 0.40 }
	end
	if style == "Aggressive" then return overhead and { 1, power } or { power, 0.7 } end
	if style == "Defensive" then return overhead and { power, 0.7 } or { 0.7, 0.55 } end
	if style == "Net" then return overhead and { 0.3, 0.2 } or { 0.45, 0.35 } end
	if overhead then return { power, 0.55, 0.3 } end
	return { 0.45, 0.35, 0.25, 0.15 }
end

local function styleAllows(style, kind, pitch)
	local overhead = kind == "OH" or kind == "JOH"
	if style == "Aggressive" then return overhead and pitch <= 5 or (not overhead and pitch <= 14) end
	if style == "Defensive" then return overhead and pitch >= 12 or (not overhead and pitch >= 18) end
	return true
end

local function styleBonus(style, sim, res)
	local depth = abs(sim.landPos.Z) / G.halfL
	if style == "Aggressive" then return (res.speedKmh or 0) / 400 end
	if style == "Defensive" then return depth * 0.4 end
	if style == "Net" then return -depth * 0.5 end
	return 0
end

