local function cameraAngles(dirZ)
	local look = camera.CFrame.LookVector
	local u = flat(look)
	if u.Magnitude < 1e-3 then return nil end
	u = u.Unit
	local yaw = math.deg(math.atan2(u:Dot(v3(-dirZ, 0, 0)), u:Dot(v3(0, 0, dirZ))))
	local pitch = math.deg(math.asin(clamp(look.Y, -1, 1)))
	return yaw, pitch
end

local function updateCameraAim(dt)
	local target = S.camTarget
	S.camAligned = false
	if not target then
		mouseAim.lastYaw = nil
		return
	end
	local yaw, pitch = cameraAngles(target.dirZ)
	if not yaw then return end
	local wantYaw = clamp(target.yaw / G.config.AIM_YAW_SCALE, -80, 80)
	local wantPitch = clamp(target.pitch - (S.aimOffset or 0), -75, 75)
	local errYaw = (wantYaw - yaw + 180) % 360 - 180
	local errPitch = wantPitch - pitch
	if abs(errYaw) < 0.6 and abs(errPitch) < 0.6 then
		S.camAligned = true
		mouseAim.lastYaw, mouseAim.sentX, mouseAim.sentY = nil, 0, 0
		return
	end
	local frac = 1 - exp(-(S.urgentAim and max(cfg.aimSpeed, 30) or cfg.aimSpeed) * dt)
	local stepYaw = clamp(errYaw * frac, -14, 14)
	local stepPitch = clamp(errPitch * frac, -10, 10)
	local useMouse = cfg.aimMethod == "Mouse" and S.focused and not mouseAim.dead
		and game:GetService("UserInputService").MouseBehavior == Enum.MouseBehavior.LockCenter
	if not useMouse then
		local cf = camera.CFrame
		local focus = camera.Focus.Position
		local dist = (cf.Position - focus).Magnitude
		local rotated = CFrame.fromAxisAngle(Vector3.yAxis, rad(-stepYaw)) * CFrame.fromAxisAngle(cf.RightVector, rad(stepPitch))
		local look = rotated:VectorToWorldSpace(cf.LookVector)
		if dist < 0.6 then
			camera.CFrame = CFrame.lookAt(cf.Position, cf.Position + look)
		else
			camera.CFrame = CFrame.lookAt(focus - look * dist, focus)
		end
		mouseAim.lastYaw = nil
		return
	end
	if not mouseAim.gainX then
		local sens = UserSettings():GetService("UserGameSettings").MouseSensitivity
		mouseAim.gainX = 0.36 * sens
		mouseAim.gainY = 0.27 * sens
	end
	mouseAim.signX = mouseAim.signX or 1
	mouseAim.signY = mouseAim.signY or 1
	if mouseAim.lastYaw and (abs(mouseAim.sentX) >= 4 or abs(mouseAim.sentY) >= 4) then
		local movedYaw = abs((yaw - mouseAim.lastYaw + 180) % 360 - 180)
		local movedPitch = abs(pitch - mouseAim.lastPitch)
		if movedYaw < 0.02 and movedPitch < 0.02 then
			mouseAim.misses = (mouseAim.misses or 0) + 1
			if mouseAim.misses >= 6 then
				mouseAim.dead = true
				hub.errors.mouse = "mousemoverel does not turn the camera here, using camera mode"
			end
		else
			mouseAim.misses = 0
		end
	end
	if mouseAim.lastYaw and abs(mouseAim.sentX) >= 4 then
		local seen = mouseAim.signX * ((yaw - mouseAim.lastYaw + 180) % 360 - 180) / mouseAim.sentX
		if seen > 0.005 and seen < 2 then mouseAim.gainX = mouseAim.gainX + (seen - mouseAim.gainX) * 0.3
		elseif seen < -0.005 then mouseAim.signX = -mouseAim.signX end
	end
	if mouseAim.lastPitch and abs(mouseAim.sentY) >= 4 then
		local seen = -mouseAim.signY * (pitch - mouseAim.lastPitch) / mouseAim.sentY
		if seen > 0.005 and seen < 2 then mouseAim.gainY = mouseAim.gainY + (seen - mouseAim.gainY) * 0.3
		elseif seen < -0.005 then mouseAim.signY = -mouseAim.signY end
	end
	local px = stepYaw / mouseAim.gainX + mouseAim.carryX
	local py = -stepPitch / mouseAim.gainY + mouseAim.carryY
	local ix = px >= 0 and floor(px) or -floor(-px)
	local iy = py >= 0 and floor(py) or -floor(-py)
	mouseAim.carryX, mouseAim.carryY = px - ix, py - iy
	if ix ~= 0 or iy ~= 0 then mousemoverel(ix * mouseAim.signX, iy * mouseAim.signY) end
	mouseAim.lastYaw, mouseAim.lastPitch, mouseAim.sentX, mouseAim.sentY = yaw, pitch, ix, iy
end

