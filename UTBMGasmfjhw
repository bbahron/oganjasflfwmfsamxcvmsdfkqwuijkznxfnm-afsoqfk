local V = {}

local function lineSet(n, thickness)
	local set = {}
	for i = 1, n do set[i] = draw("Line", { Thickness = thickness or 1.5, Transparency = 1 }) end
	return set
end

local function hideSet(set, from)
	for i = from or 1, #set do set[i].Visible = false end
end

V.ring = lineSet(28, 2)
V.ringInner = lineSet(16, 1)
V.trail = lineSet(36, 2)
V.stand = lineSet(4, 2)
V.aimRing = lineSet(20, 2)
V.landText = draw("Text", { Size = 15, Center = true, Outline = true, Font = 2 })
V.leaveText = draw("Text", { Size = 28, Center = true, Outline = true, Font = 3, Text = "LEAVE IT" })
V.aimText = draw("Text", { Size = 13, Center = true, Outline = true, Font = 2 })
V.status = draw("Text", { Size = 14, Center = false, Outline = true, Font = 2, Color = rgb(235, 238, 245) })
V.heat = {}
for i = 1, GRID * GRID * 2 do V.heat[i] = draw("Quad", { Filled = true, Thickness = 1 }) end

local function project(p)
	local s = camera:WorldToViewportPoint(p)
	return v2(s.X, s.Y), s.Z > 0.5
end

local function drawRing(set, centre, radius, colour, alpha, spin)
	local n = #set
	local prevPos, prevOn
	for i = 0, n do
		local a = (i / n) * math.pi * 2 + (spin or 0)
		local p = centre + v3(cos(a) * radius, 0, sin(a) * radius)
		local pos, on = project(p)
		if i > 0 then
			local l = set[i]
			if on and prevOn then
				l.From, l.To, l.Color, l.Transparency, l.Visible = prevPos, pos, colour, alpha, true
			else
				l.Visible = false
			end
		end
		prevPos, prevOn = pos, on
	end
end

local function drawHeat(view, side, grid, total, colour, offset)
	if total == 0 then
		for i = 1, GRID * GRID do V.heat[offset + i].Visible = false end
		return
	end
	local peak = 0
	for i = 1, GRID do for j = 1, GRID do peak = max(peak, grid[i][j]) end end
	local zSign = side * view.dirZ
	local cellW = 2 * view.halfW / GRID
	local cellL = G.halfL / GRID
	local k = offset
	for i = 1, GRID do
		for j = 1, GRID do
			k = k + 1
			local q = V.heat[k]
			local amount = peak > 0 and grid[i][j] / peak or 0
			if amount <= 0 then
				q.Visible = false
			else
				local x0 = view.cx - view.halfW + (i - 1) * cellW
				local z0 = (j - 1) * cellL * zSign
				local z1 = j * cellL * zSign
				local y = 0.12
				local a, onA = project(v3(x0, y, z0))
				local b, onB = project(v3(x0 + cellW, y, z0))
				local cc, onC = project(v3(x0 + cellW, y, z1))
				local d, onD = project(v3(x0, y, z1))
				if onA and onB and onC and onD then
					q.PointA, q.PointB, q.PointC, q.PointD = a, b, cc, d
					q.Color = colour
					q.Transparency = 0.15 + 0.5 * amount
					q.Visible = true
				else
					q.Visible = false
				end
			end
		end
	end
end

local function hideAll()
	for d in pairs(drawings) do d.Visible = false end
end

local updateVisuals = LPH_NO_VIRTUALIZE(function(dt, now)
	local view = S.view
	if not view then hideAll() return end
	local serverNow = workspace:GetServerTimeNow()
	local pulse = 0.5 + 0.5 * sin(now * 6)

	local flight = view.flight
	if flight and cfg.landMarker and view.land and view.landTime > serverNow - 0.2 then
		local colour = view.landIn and cfg.landInColour or cfg.landOutColour
		if view.netHit then colour = rgb(200, 200, 210) end
		local base = v3(view.land.X, 0.15, view.land.Z)
		drawRing(V.ring, base, 1.6 + 0.25 * pulse, colour, 1, now * 0.8)
		drawRing(V.ringInner, base, 0.55, colour, 0.8, -now * 1.5)
		local pos, on = project(base + v3(0, 1.4, 0))
		local left = view.landTime - serverNow
		V.landText.Text = string.format("%s  %.2fs", view.netHit and "NET" or (view.landIn and "IN" or "OUT"), max(left, 0))
		V.landText.Position = pos
		V.landText.Color = colour
		V.landText.Visible = on
	else
		hideSet(V.ring)
		hideSet(V.ringInner)
		V.landText.Visible = false
	end

	if flight and cfg.trajectory and flight.pts and view.landTime > serverNow then
		local pts = flight.pts
		local first = clamp(floor((serverNow - flight.t0) / G.simDt) + 1, 1, #pts)
		local count = #V.trail
		local stride = max(1, floor((#pts - first) / count))
		local prevPos, prevOn = project(pts[first])
		local used = 0
		local idx = first
		for i = 1, count do
			local nextIdx = min(#pts, idx + stride)
			if nextIdx == idx then break end
			local pos, on = project(pts[nextIdx])
			local l = V.trail[i]
			if on and prevOn then
				l.From, l.To = prevPos, pos
				l.Color = cfg.trajectoryColour
				l.Transparency = 1 - (i / count) * 0.6
				l.Visible = true
			else
				l.Visible = false
			end
			used = i
			prevPos, prevOn, idx = pos, on, nextIdx
		end
		hideSet(V.trail, used + 1)
	else
		hideSet(V.trail)
	end

	if cfg.leaveWarn and view.leave then
		V.leaveText.Position = v2(camera.ViewportSize.X / 2, camera.ViewportSize.Y * 0.32)
		V.leaveText.Color = cfg.landOutColour
		V.leaveText.Transparency = 0.6 + 0.4 * pulse
		V.leaveText.Visible = true
	else
		V.leaveText.Visible = false
	end

	local plan = view.plan
	if cfg.interceptMarker and plan and view.incoming then
		local c = v3(plan.stand.X, 0.15, plan.stand.Z)
		local r = 0.9
		local corners = { c + v3(r, 0, 0), c + v3(0, 0, r), c + v3(-r, 0, 0), c + v3(0, 0, -r) }
		for i = 1, 4 do
			local a, onA = project(corners[i])
			local b, onB = project(corners[i % 4 + 1])
			local l = V.stand[i]
			if onA and onB then
				l.From, l.To, l.Color, l.Visible = a, b, cfg.interceptColour, true
			else
				l.Visible = false
			end
		end
	else
		hideSet(V.stand)
	end

	local aim = view.aim or view.serveAim
	if cfg.aimMarker and aim and aim.land then
		local base = v3(aim.land.X, 0.15, aim.land.Z)
		drawRing(V.aimRing, base, 1.1, cfg.aimColour, 0.9, now * 2)
		local pos, on = project(base + v3(0, 1.2, 0))
		V.aimText.Text = aim.shot and string.format("%s %s", aim.shot, aim.kmh and (aim.kmh .. " km/h") or "") or "TARGET"
		V.aimText.Position = pos
		V.aimText.Color = cfg.aimColour
		V.aimText.Visible = on
	else
		hideSet(V.aimRing)
		V.aimText.Visible = false
	end

	if view.halfW and cfg.heatTheirs then
		drawHeat(view, 1, tracker.theirs, tracker.theirsTotal, rgb(244, 63, 94), 0)
	else
		for i = 1, GRID * GRID do V.heat[i].Visible = false end
	end
	if view.halfW and cfg.heatMine then
		drawHeat(view, -1, tracker.mine, tracker.mineTotal, rgb(96, 165, 250), GRID * GRID)
	else
		for i = GRID * GRID + 1, GRID * GRID * 2 do V.heat[i].Visible = false end
	end

	if cfg.statusText then
		local mode = cfg.autoPlay and "AUTO" or (cfg.releaseAssist and "ASSIST" or "MANUAL")
		local defInfo = ""
		if cfg.learnDefender and defender.shotCount > 0 then
			local c = hub.ctx
			local dm = c and defenderGet(c)
			if dm and dm.shotCount >= 6 then
				defInfo = string.format("  |  def: %s", defenderSummary(dm))
			elseif dm then
				defInfo = string.format("  |  learning (%d/6)", dm.shotCount)
			end
		end
		V.status.Text = string.format("%s  %s  stamina %d%s", mode, view.status or "", floor(view.stamina or 0), defInfo)
		V.status.Position = v2(18, camera.ViewportSize.Y - 64)
		V.status.Visible = true
	else
		V.status.Visible = false
	end
end)

